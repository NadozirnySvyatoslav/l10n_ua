<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             Medical records (patients and their ПМД declarations) must be
             scoped to the user's allowed companies — without these rules the
             records were visible across ALL companies, including non-UA ones.
             The declaration model is DEFINED in this module (extended by
             l10n_ua_medecin_ehealth), so its rule ships here too — it must
             protect the data wherever the model exists, even when the eHealth
             module is not installed. Standard Odoo pattern (see hr_order rule). -->

        <record id="l10n_ua_medecin_patient_company_rule" model="ir.access">
            <field name="name">Пацієнт: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_medecin_patient"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

        <record id="l10n_ua_medecin_declaration_company_rule" model="ir.access">
            <field name="name">Декларація з лікарем ПМД: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_medecin_declaration"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

    </data>
</odoo>
