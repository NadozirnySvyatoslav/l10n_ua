#. module: l10n_ua_bank_mono
#: model:ir.model.fields,help:l10n_ua_bank_mono.field_l10n_ua_bank_sync_config__mono_api_type
msgid "Personal API (api.monobank.ua) serves individuals and individual entrepreneurs, with a token from the monobank app. Corporate API (corp-api.monobank.ua) serves legal entities, with a token issued for the company in the monobank web cabinet."
msgstr "Персональний API (api.monobank.ua) — для фізичних осіб і ФОП, токен із застосунку monobank. Корпоративний API (corp-api.monobank.ua) — для юридичних осіб, токен видається для компанії у web-кабінеті monobank."

#. module: l10n_ua_bank_mono
#: model:ir.model.fields,help:l10n_ua_bank_mono.field_l10n_ua_bank_sync_config__mono_api_token
msgid "Personal API: token from monobank settings (Настройки → API). Corporate API: company token from web.monobank.ua."
msgstr "Персональний API: токен із налаштувань monobank (Налаштування → API). Корпоративний API: токен компанії з web.monobank.ua."

#. module: l10n_ua_bank_mono
#: model:ir.model.fields,help:l10n_ua_bank_mono.field_l10n_ua_bank_sync_config__mono_account_id
msgid "Personal API: monobank account ID (optional, fetched automatically). Corporate API: account IBAN (optional, the IBAN of the journal bank account is used by default)."
msgstr "Персональний API: ID рахунку monobank (необов'язково, визначається автоматично). Корпоративний API: IBAN рахунку (необов'язково, типово береться IBAN банківського рахунку журналу)."

#. module: l10n_ua_bank_mono
#: model_terms:ir.ui.view,arch_db:l10n_ua_bank_mono.l10n_ua_bank_sync_config_view_form_mono
msgid "Account IBAN"
msgstr "IBAN рахунку"

