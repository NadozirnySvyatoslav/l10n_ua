#. odoo-python
#: code:addons/l10n_ua_bank_mono/models/l10n_ua_bank_mono_config.py:0
msgid "monobank API rate limit exceeded. Retry in %s seconds."
msgstr "Перевищено ліміт запитів monobank API. Повторіть через %s с."

#. module: l10n_ua_bank_mono
#. odoo-python
#: code:addons/l10n_ua_bank_mono/models/l10n_ua_bank_mono_config.py:0
msgid "Set the account IBAN or a bank account on the journal to read the monobank corporate statement."
msgstr "Вкажіть IBAN рахунку або банківський рахунок у журналі, щоб отримати корпоративну виписку monobank."

#. module: l10n_ua_bank_mono
#. odoo-python
#: code:addons/l10n_ua_bank_mono/models/l10n_ua_bank_mono_config.py:0
msgid "monobank statement for %s has more than %s pages; shorten the period."
msgstr "Виписка monobank за рахунком %s має понад %s сторінок; скоротіть період."

#. module: l10n_ua_bank_mono
#. odoo-python
#: code:addons/l10n_ua_bank_mono/models/l10n_ua_bank_mono_config.py:0
msgid "Connected to monobank corporate API, but account %(iban)s is not among the company's %(count)d accounts."
msgstr "Підключено до корпоративного API monobank, але рахунку %(iban)s немає серед %(count)d рахунків компанії."

#. module: l10n_ua_bank_mono
#. odoo-python
#: code:addons/l10n_ua_bank_mono/models/l10n_ua_bank_mono_config.py:0
msgid "Connected to monobank corporate API. Accounts: %d"
msgstr "Підключено до корпоративного API monobank. Рахунків: %d"

#. module: l10n_ua_bank_mono
#. odoo-python
#: code:addons/l10n_ua_bank_mono/models/l10n_ua_bank_mono_config.py:0
msgid "Warning"
