<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rule (issue #178).
             Clinical encounters must be scoped to the user's allowed companies —
             without this rule the records were visible across ALL companies,
             including non-UA ones. Standard Odoo pattern (see hr_order rule). -->

        <record id="l10n_ua_medecin_encounter_company_rule" model="ir.access">
            <field name="name">Прийом (encounter): multi-company</field>
            <field name="model_id" ref="model_l10n_ua_medecin_encounter"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

    </data>
</odoo>
