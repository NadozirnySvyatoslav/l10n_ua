<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_icd10_list" model="ir.ui.view">
        <field name="name">l10n_ua.medecin.icd10.list</field>
        <field name="model">l10n_ua.medecin.icd10</field>
        <field name="arch" type="xml">
            <list string="МКХ-10" decoration-muted="not is_selectable">
                <field name="code"/>
                <field name="name"/>
                <field name="level" optional="show"/>
                <field name="is_selectable" optional="show"/>
                <field name="block" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_icd10_form" model="ir.ui.view">
        <field name="name">l10n_ua.medecin.icd10.form</field>
        <field name="model">l10n_ua.medecin.icd10</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="level"/>
                        <field name="is_selectable"/>
                        <field name="block"/>
                        <field name="parent_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Підрубрики" invisible="not child_ids">
                        <field name="child_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="is_selectable"/>
                            </list>
                        </field>
                    </group>
                    <group string="Опис">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_icd10_search" model="ir.ui.view">
        <field name="name">l10n_ua.medecin.icd10.search</field>
        <field name="model">l10n_ua.medecin.icd10</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Код або назва"/>
                <field name="code" filter_domain="[('code', '=ilike', self + '%')]"/>
                <field name="name"/>
                <field name="parent_id" string="У складі" operator="child_of"/>
                <filter string="Допустимі як діагноз" name="filter_selectable" domain="[('is_selectable', '=', True)]"/>
                <separator/>
                <filter string="Класи" name="filter_chapter" domain="[('level', '=', 'chapter')]"/>
                <filter string="Блоки" name="filter_block" domain="[('level', '=', 'block')]"/>
                <filter string="Рубрики (3 знаки)" name="filter_category" domain="[('level', '=', 'category')]"/>
                <separator/>
                <filter string="Архівовані" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Рівень" name="groupby_level" domain="[]" context="{'group_by': 'level'}"/>
                    <filter string="Блок" name="groupby_block" domain="[]" context="{'group_by': 'block'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_icd10" model="ir.actions.act_window">
        <field name="name">МКХ-10</field>
        <field name="res_model">l10n_ua.medecin.icd10</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_selectable': 1}</field>
    </record>
</odoo>
