<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             UA tax documents carry company_id but had NO multi-company rule,
             so records leaked across ALL companies, including non-UA ones.
             Standard Odoo pattern (see l10n_ua_account_vat). -->

        <record id="l10n_ua_tax_document_company_rule" model="ir.access">
            <field name="name">Податковий документ: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_tax_document"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

    </data>
</odoo>
