<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_tax_period_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.tax.period.form</field>
        <field name="model">l10n_ua.tax.period</field>
        <field name="arch" type="xml">
            <form string="Tax Period">
                <header>
                    <button name="action_close" string="Close" type="object" invisible="state != 'open'"/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="period_type"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="year" options="{'enable_formatting': false}"/>
                            <field name="quarter" invisible="period_type == 'month'"/>
                            <field name="month" invisible="period_type != 'month'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ua_tax_period_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.tax.period.list</field>
        <field name="model">l10n_ua.tax.period</field>
        <field name="arch" type="xml">
            <list string="Tax Periods">
                <field name="name"/>
                <field name="period_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_tax_period_action" model="ir.actions.act_window">
        <field name="name">Tax Periods</field>
        <field name="res_model">l10n_ua.tax.period</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
