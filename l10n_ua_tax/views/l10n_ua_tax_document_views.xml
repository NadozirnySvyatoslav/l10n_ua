<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="l10n_ua_tax_document_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.tax.document.list</field>
        <field name="model">l10n_ua.tax.document</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'rejected'" decoration-success="state == 'accepted'">
                <field name="document_date"/>
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="document_number" optional="show"/>
                <field name="year" options="{'enable_formatting': false}"/>
                <field name="period"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'prepared'"
                       decoration-primary="state == 'submitted'"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="l10n_ua_tax_document_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.tax.document.form</field>
        <field name="model">l10n_ua.tax.document</field>
        <field name="arch" type="xml">
            <!-- Документи лише з кабінету ДПС (синхронізація), тому лише перегляд -->
            <form create="0" edit="0">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="submitted,accepted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group string="Document Info">
                            <field name="name"/>
                            <field name="document_type_id"/>
                            <field name="document_number"/>
                            <field name="document_date"/>
                        </group>
                        <group string="Period">
                            <field name="year" options="{'enable_formatting': false}"/>
                            <field name="period"/>
                            <field name="period_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Company">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="taxpayer_code"/>
                        </group>
                        <group string="Status">
                            <field name="status_message" invisible="not status_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="PDF Preview" name="pdf_preview" invisible="not file_pdf">
                            <field name="file_pdf" widget="pdf_viewer"/>
                        </page>
                        <page string="XML Preview" name="xml_preview" invisible="not file_xml">
                            <field name="file_xml_content" widget="ace" options="{'mode': 'xml'}"/>
                        </page>
                        <page string="Files" name="files">
                            <group>
                                <group>
                                    <field name="file_xml" filename="file_xml_name"/>
                                    <field name="file_xml_name" invisible="1"/>
                                </group>
                                <group>
                                    <field name="file_pdf" filename="file_pdf_name"/>
                                    <field name="file_pdf_name" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="l10n_ua_tax_document_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.tax.document.search</field>
        <field name="model">l10n_ua.tax.document</field>
        <field name="arch" type="xml">
            <search string="Tax Documents">
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <field name="taxpayer_code"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="accepted" string="Accepted" domain="[('state', '=', 'accepted')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="l10n_ua_tax_document_action" model="ir.actions.act_window">
        <field name="name">Tax Documents</field>
        <field name="res_model">l10n_ua.tax.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_ua_tax_document_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tax documents yet
            </p>
            <p>
                Documents appear here after synchronisation with the Tax Cabinet.
            </p>
        </field>
    </record>

</odoo>
