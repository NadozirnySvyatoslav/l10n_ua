<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_import" model="ir.ui.view">
        <field name="name">account.move.form.import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_l10n_ua_import_declarations" type="object" class="oe_stat_button"
                        icon="fa-ship" invisible="move_type != 'in_invoice' or state == 'cancel'"
                        groups="account.group_account_invoice">
                    <span class="o_stat_text">Customs</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
