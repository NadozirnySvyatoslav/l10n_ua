<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_balance_report_form_dps" model="ir.ui.view">
        <field name="name">l10n_ua.balance.report.form.dps</field>
        <field name="model">l10n_ua.balance.report</field>
        <field name="inherit_id" ref="l10n_ua_accounting.view_balance_report_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_generate_dps_xml" type="object" string="DPS XML"
                        icon="fa-file-code-o"
                        invisible="state != 'confirmed' or submission_date"/>
                <button name="action_kep_submit" type="object" string="Submit to DPS"
                        class="btn-primary"
                        invisible="state != 'confirmed' or submission_date"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="DPS" invisible="not xml_file and not submission_date">
                    <field name="xml_file" filename="xml_filename" invisible="not xml_file"/>
                    <field name="xml_filename" invisible="1"/>
                    <field name="submission_date" invisible="not submission_date"/>
                </group>
            </xpath>
        </field>
    </record>

