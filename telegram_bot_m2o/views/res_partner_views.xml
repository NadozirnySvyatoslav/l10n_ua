<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_telegram_send" model="ir.ui.view">
        <field name="name">res.partner.form.telegram.send</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="telegram_chat_count" invisible="1"/>
                <button name="action_open_telegram_send" type="object"
                        class="oe_stat_button" icon="fa-paper-plane"
                        invisible="telegram_chat_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Send</span>
                        <span class="o_stat_text">Telegram</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
