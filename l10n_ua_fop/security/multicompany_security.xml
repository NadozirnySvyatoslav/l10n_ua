<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             FOP documents must be scoped to the user's allowed companies —
             without these rules the records leaked across ALL companies,
             including non-UA ones. Standard Odoo pattern (see l10n_ua_account_vat). -->

        <record id="l10n_ua_fop_declaration_company_rule" model="ir.access">
            <field name="name">Декларація ФОП: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_fop_declaration"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

        <record id="l10n_ua_fop_income_book_company_rule" model="ir.access">
            <field name="name">Книга доходів ФОП: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_fop_income_book"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

    </data>
</odoo>
