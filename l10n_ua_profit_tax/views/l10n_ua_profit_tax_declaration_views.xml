<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_profit_tax_declaration_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.profit.tax.declaration.form</field>
        <field name="model">l10n_ua.profit.tax.declaration</field>
        <field name="arch" type="xml">
            <form string="Profit Tax Declaration">
                <header>
                    <button name="action_calculate" string="Calculate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_calculate" string="Recalculate" type="object"
                            invisible="state != 'calculated'"/>
                    <button name="action_generate_xml" string="Generate XML" type="object"
                            invisible="state != 'calculated'"/>
                    <button name="action_submit" string="Sign and Submit" type="object"
                            class="btn-primary" invisible="state != 'calculated'"/>
                    <button name="action_accept" string="Accepted" type="object"
                            invisible="state != 'submitted'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state in ('draft', 'accepted')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculated,submitted,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state not in ('submitted', 'accepted')">
                        The declaration has been submitted to the DPS: its amounts are locked.
                        Errors are corrected with a corrective declaration.
                    </div>
                    <group>
                        <group string="Period">
                            <field name="year" options="{'enable_formatting': false}"
                                   readonly="state != 'draft'"/>
                            <field name="period" readonly="state != 'draft'"/>
                            <field name="base_period" readonly="state != 'draft'"/>
                            <field name="doc_kind" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Calculation">
                            <field name="line_01" readonly="state not in ('draft', 'calculated')"/>
                            <field name="line_02" readonly="state not in ('draft', 'calculated')"/>
                            <field name="line_03"/>
                            <field name="line_04"/>
                            <field name="tax_rate" readonly="state not in ('draft', 'calculated')"/>
                            <field name="line_06"/>
                            <field name="line_17"/>
                            <field name="line_18" invisible="base_period != 'quarter' or period == 'q1'"
                                   readonly="state not in ('draft', 'calculated')"/>
                            <field name="line_19"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Appendix РІ" name="ri">
                            <group>
                                <field name="no_adjustments"
                                       readonly="state not in ('draft', 'calculated')"/>
                            </group>
                            <group invisible="no_adjustments">
                                <group string="Increase the financial result">
                                    <field name="ri_2_1_1" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_2_1_2" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_2_1_3" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_3_1_1" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_3_1_10" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_3_1_11" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_increase"/>
                                </group>
                                <group string="Decrease the financial result">
                                    <field name="ri_2_2_1" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_2_2_2" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_2_2_3" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_3_2_1" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_3_2_3" readonly="state not in ('draft', 'calculated')"/>
                                    <field name="ri_decrease"/>
                                </group>
                            </group>
                            <group string="Loss of previous years">
                                <field name="ri_3_2_4" readonly="state not in ('draft', 'calculated')"/>
                            </group>
                        </page>
                        <page string="Submission" name="submission">
                            <group>
                                <group string="Signatories">
                                    <field name="signatory_name" readonly="state in ('submitted', 'accepted')"/>
                                    <field name="signatory_rnokpp" readonly="state in ('submitted', 'accepted')"/>
                                    <field name="accountant_name" readonly="state in ('submitted', 'accepted')"/>
                                    <field name="accountant_rnokpp" readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="DPS">
                                    <field name="xml_file" filename="xml_filename" readonly="1"/>
                                    <field name="xml_filename" invisible="1"/>
                                    <field name="ri_xml_file" filename="ri_xml_filename" readonly="1"
                                           invisible="not ri_xml_file"/>
                                    <field name="ri_xml_filename" invisible="1"/>
                                    <field name="submission_date" readonly="1"/>
                                    <field name="dps_submission_id" invisible="not dps_submission_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_profit_tax_declaration_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.profit.tax.declaration.list</field>
        <field name="model">l10n_ua.profit.tax.declaration</field>
        <field name="arch" type="xml">
            <list string="Profit Tax Declarations">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="line_02"/>
                <field name="line_04"/>
                <field name="line_17"/>
                <field name="line_19"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'accepted'"
                       decoration-info="state == 'submitted'"
                       decoration-warning="state == 'calculated'"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_profit_tax_declaration_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.profit.tax.declaration.search</field>
        <field name="model">l10n_ua.profit.tax.declaration</field>
        <field name="arch" type="xml">
            <search string="Profit Tax Declarations">
                <field name="name"/>
                <field name="year"/>
                <filter string="Drafts" name="filter_draft" domain="[('state', 'in', ('draft', 'calculated'))]"/>
                <filter string="Filed" name="filter_filed" domain="[('state', 'in', ('submitted', 'accepted'))]"/>
                <separator/>
                <group>
                    <filter string="Year" name="groupby_year" domain="[]" context="{'group_by': 'year'}"/>
                    <filter string="Company" name="groupby_company" domain="[]" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ua_profit_tax_declaration_action" model="ir.actions.act_window">
        <field name="name">Profit Tax Declarations</field>
        <field name="res_model">l10n_ua.profit.tax.declaration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_ua_profit_tax_declarations"
              name="Profit Tax Declarations"
              parent="l10n_ua_tax.menu_ua_tax_reporting"
              action="l10n_ua_profit_tax_declaration_action"
              sequence="15"/>

</odoo>
