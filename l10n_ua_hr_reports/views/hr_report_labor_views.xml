<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_report_labor_view_form" model="ir.ui.view">
        <field name="name">hr.report.labor.form</field>
        <field name="model">hr.report.labor</field>
        <field name="arch" type="xml">
            <form string="Labour Report 1-PV">
                <header>
                    <button name="action_compute" string="Compute" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            invisible="state != 'draft' or not computed_on"/>
                    <button name="action_print" string="Print" type="object"
                            invisible="not computed_on"/>
                    <button name="action_export_xlsx" string="Export XLSX" type="object"
                            invisible="not computed_on"/>
                    <button name="action_export_xml" string="Export XML" type="object"
                            invisible="not computed_on or submission_date"/>
                    <button name="action_kep_submit" string="Submit to Statistics" type="object"
                            class="btn-primary"
                            invisible="state != 'done' or not computed_on or submission_date"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state == 'draft' or submission_date"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not needs_explanation">
                        The average headcount changed by 25% or more, or the average wage by 10%
                        or more, against the previous month: the form requires the reason on the
                        Explanations tab.
                    </div>
                    <group>
                        <group string="Period">
                            <field name="period_type" readonly="id"/>
                            <field name="year" options="{'enable_formatting': false}" readonly="id"/>
                            <field name="month" readonly="id" invisible="period_type != 'month'"
                                   required="period_type == 'month'"/>
                            <field name="quarter" readonly="id" invisible="period_type != 'quarter'"
                                   required="period_type == 'quarter'"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Filing">
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="id"/>
                            <field name="date_deadline"/>
                            <field name="computed_on"/>
                            <field name="xml_file" filename="xml_filename"
                                   invisible="not xml_file"/>
                            <field name="xml_filename" invisible="1"/>
                            <field name="submission_date" invisible="not submission_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rows" name="rows">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-muted="not is_auto and not is_manual"
                                      decoration-info="is_manual">
                                    <field name="report_state" column_invisible="1"/>
                                    <field name="code" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="column_label" optional="show"/>
                                    <field name="unit" readonly="1" optional="show"/>
                                    <field name="is_auto" optional="hide"/>
                                    <field name="computed_value"/>
                                    <field name="is_manual" readonly="not is_auto"/>
                                    <field name="manual_value" readonly="not is_manual"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Explanations" name="explanations"
                              invisible="period_type != 'month'">
                            <group>
                                <field name="headcount_change"/>
                                <field name="explanation_headcount"/>
                                <field name="avg_wage_change"/>
                                <field name="explanation_avg_wage"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_company_form_stat_district" model="ir.ui.view">
        <field name="name">res.company.form.l10n_ua.stat.district</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_ua_company_base.view_company_form_inherit_ua"/>
        <field name="arch" type="xml">
            <field name="katottg" position="after">
                <field name="l10n_ua_stat_district_code" placeholder="напр. 007"/>
            </field>
        </field>
    </record>

    <record id="hr_report_labor_view_list" model="ir.ui.view">
        <field name="name">hr.report.labor.list</field>
        <field name="model">hr.report.labor</field>
        <field name="arch" type="xml">
            <list string="Labour Reports 1-PV">
                <field name="name"/>
                <field name="period_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="date_deadline"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="hr_report_labor_view_search" model="ir.ui.view">
        <field name="name">hr.report.labor.search</field>
        <field name="model">hr.report.labor</field>
        <field name="arch" type="xml">
            <search string="Labour Reports 1-PV">
                <field name="name"/>
                <field name="year"/>
                <filter string="Monthly" name="filter_month" domain="[('period_type', '=', 'month')]"/>
                <filter string="Quarterly" name="filter_quarter" domain="[('period_type', '=', 'quarter')]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <group>
                    <filter string="Year" name="groupby_year" domain="[]" context="{'group_by': 'year'}"/>
                    <filter string="Form" name="groupby_period_type" domain="[]" context="{'group_by': 'period_type'}"/>
                    <filter string="Status" name="groupby_state" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_report_labor" model="ir.actions.act_window">
        <field name="name">Labour Report 1-PV</field>
        <field name="res_model">hr.report.labor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a 1-PV labour report
            </p>
            <p>
                The monthly and quarterly «Звіт із праці» of the State Statistics
                Service (order № 117 of 15.04.2024): headcount, hours worked and
                the wage fund computed from payslips and contracts.
            </p>
        </field>
    </record>

    <record id="hr_accrual_type_view_form_1pv" model="ir.ui.view">
        <field name="name">hr.accrual.type.form.1pv</field>
        <field name="model">hr.accrual.type</field>
        <field name="inherit_id" ref="l10n_ua_hr_salary.hr_accrual_type_view_form"/>
        <field name="arch" type="xml">
            <field name="d4_income_type" position="after">
                <field name="l10n_ua_1pv_group"/>
            </field>
        </field>
    </record>

</odoo>
