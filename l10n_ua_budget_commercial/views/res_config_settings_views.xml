<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_budget" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n_ua.budget.commercial</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Budgeting" name="l10n_ua_budget_setting_container">
                    <setting id="l10n_ua_budget_control" string="Budget Control on Vendor Bills"
                             company_dependent="1"
                             help="Check approved Income &amp; Expense budgets when a vendor bill is posted">
                        <field name="l10n_ua_budget_control"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
