<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_budget_plan_company" model="ir.rule">
            <field name="name">Budget plan: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_budget_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_budget_line_company" model="ir.rule">
            <field name="name">Budget line: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_budget_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_budget_item_company" model="ir.rule">
            <field name="name">Budget item: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_budget_item"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
