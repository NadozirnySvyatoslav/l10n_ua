<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_copy_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ua.budget.copy.wizard.form</field>
        <field name="model">l10n_ua.budget.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="Copy Budget">
                <group>
                    <field name="plan_id" readonly="1"/>
                    <field name="name"/>
                    <field name="scenario"/>
                    <field name="shift_months"/>
                    <field name="coefficient"/>
                    <field name="copy_children"/>
                </group>
                <footer>
                    <button name="action_copy" type="object" string="Copy" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_budget_copy_wizard" model="ir.actions.act_window">
        <field name="name">Copy Budget</field>
        <field name="res_model">l10n_ua.budget.copy.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_budget_xlsx_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ua.budget.xlsx.wizard.form</field>
        <field name="model">l10n_ua.budget.xlsx.wizard</field>
        <field name="arch" type="xml">
            <form string="Excel">
                <field name="mode" invisible="1"/>
                <field name="plan_id" invisible="1"/>
                <div invisible="mode != 'import'" class="text-muted mb-3">
                    Upload a workbook in the export format: item code, item name, analytic
                    account, then one column per budget period. Empty cells are skipped,
                    existing lines are updated, missing ones are created.
                </div>
                <group>
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" filename="file_name"
                           invisible="mode == 'export' and not file_data"
                           readonly="mode == 'export'"/>
                    <field name="import_result" invisible="not import_result"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export" class="btn-primary"
                            invisible="mode != 'export' or file_data"/>
                    <button name="action_import" type="object" string="Import" class="btn-primary"
                            invisible="mode != 'import' or import_result"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_budget_xlsx_export" model="ir.actions.act_window">
        <field name="name">Export Budget to Excel</field>
        <field name="res_model">l10n_ua.budget.xlsx.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_plan_id': active_id, 'default_mode': 'export'}</field>
    </record>

    <record id="action_budget_xlsx_import" model="ir.actions.act_window">
        <field name="name">Import Budget from Excel</field>
        <field name="res_model">l10n_ua.budget.xlsx.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_plan_id': active_id, 'default_mode': 'import'}</field>
    </record>
</odoo>
