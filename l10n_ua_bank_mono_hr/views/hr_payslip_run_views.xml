<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_payslip_run_view_form_mono" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.mono</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="l10n_ua_hr_salary.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_bank_export']" position="after">
                <button name="action_mono_payslip_import" string="Листи в monobank"
                        type="object" invisible="state == 'draft'"
                        groups="l10n_ua_hr_base.group_hr_ua_officer"/>
            </xpath>
        </field>
    </record>

</odoo>
