<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Договір на формі платежу -->
    <record id="view_account_payment_form_agreement" model="ir.ui.view">
        <field name="name">account.payment.form.agreement</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="l10n_ua_agreement_id"
                       domain="[('commercial_partner_id', '=', partner_id)]"/>
            </xpath>
        </field>
    </record>

    <!-- Договір у пошуку/групуванні платежів -->
    <record id="view_account_payment_search_agreement" model="ir.ui.view">
        <field name="name">account.payment.search.agreement</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="l10n_ua_agreement_id"/>
            </xpath>
            <xpath expr="//filter[@name='partner']" position="after">
                <filter string="Agreement" name="groupby_agreement" domain="[]"
                        context="{'group_by': 'l10n_ua_agreement_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
