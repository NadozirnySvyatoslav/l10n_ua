<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Договір на формі рахунку -->
    <record id="view_move_form_agreement" model="ir.ui.view">
        <field name="name">account.move.form.agreement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="l10n_ua_agreement_id"
                       domain="[('commercial_partner_id', '=', commercial_partner_id)]"/>
            </xpath>
        </field>
    </record>

    <!-- Договір у пошуку/групуванні проводок -->
    <record id="view_account_move_filter_agreement" model="ir.ui.view">
        <field name="name">account.move.select.agreement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="l10n_ua_agreement_id"/>
            </xpath>
            <xpath expr="//filter[@name='partner']" position="after">
                <filter string="Agreement" name="groupby_agreement" domain="[]"
                        context="{'group_by': 'l10n_ua_agreement_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
