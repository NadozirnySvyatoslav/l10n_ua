<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Договір у майстрі акту звірки -->
    <record id="view_reconciliation_act_wizard_form_agreement" model="ir.ui.view">
        <field name="name">l10n_ua.reconciliation.act.wizard.form.agreement</field>
        <field name="model">l10n_ua.reconciliation.act.wizard</field>
        <field name="inherit_id"
               ref="l10n_ua_accounting.view_reconciliation_act_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="l10n_ua_agreement_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
