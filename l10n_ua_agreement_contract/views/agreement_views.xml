<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ua_agreement_view_form_contract" model="ir.ui.view">
        <field name="name">l10n_ua.agreement.form.contract</field>
        <field name="model">l10n_ua.agreement</field>
        <field name="inherit_id" ref="l10n_ua_agreement.l10n_ua_agreement_view_form"/>
        <field name="arch" type="xml">
            <button name="action_print_act" position="before">
                <button name="action_create_contract" type="object"
                        string="Create Recurring Contract"
                        invisible="state != 'signed'"/>
            </button>
            <div name="button_box" position="inside">
                <button name="action_view_contracts" type="object"
                        class="oe_stat_button" icon="fa-refresh"
                        invisible="contract_count == 0">
                    <field name="contract_count" widget="statinfo" string="Recurring"/>
                </button>
            </div>
        </field>
    </record>

    <record id="contract_contract_form_view_l10n_ua_agreement" model="ir.ui.view">
        <field name="name">contract.contract.form.l10n_ua_agreement</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="l10n_ua_agreement_id" options="{'no_create': True}"
                       domain="[('partner_id', 'child_of', partner_id)]"/>
            </field>
        </field>
    </record>
</odoo>
