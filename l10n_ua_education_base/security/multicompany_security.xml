<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             Education records carry a company_id ('Установа') but had no
             multi-company ir.rule, so they were visible across ALL companies,
             including non-education / non-UA ones. These global rules scope
             each record to the user's allowed companies. Standard Odoo pattern
             (see l10n_ua_account_vat_security.xml). company_id is stored on all
             three models (direct on academic.year & contingent.member; related
             store=True on group), so a plain company_id domain is correct. -->

        <record id="l10n_ua_education_academic_year_company_rule" model="ir.access">
            <field name="name">Навчальний рік: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_education_academic_year"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

        <record id="l10n_ua_education_group_company_rule" model="ir.access">
            <field name="name">Навчальна група: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_education_group"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

        <record id="l10n_ua_education_contingent_member_company_rule" model="ir.access">
            <field name="name">Член контингенту: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_education_contingent_member"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

    </data>
</odoo>
