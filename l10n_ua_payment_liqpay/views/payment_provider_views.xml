<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">LiqPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'liqpay'">
                    <field name="liqpay_public_key" string="Public Key"
                           required="code == 'liqpay' and state != 'disabled'"/>
                    <field name="liqpay_private_key" string="Private Key"
                           required="code == 'liqpay' and state != 'disabled'" password="True"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
