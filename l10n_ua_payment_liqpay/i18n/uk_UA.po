#. module: l10n_ua_payment_liqpay
#: model_terms:payment.provider,auth_msg:l10n_ua_payment_liqpay.payment_provider_liqpay
msgid "<span>Your payment has been authorized.</span>"
msgstr "<span>Ваш платіж авторизовано.</span>"

#. module: l10n_ua_payment_liqpay
#: model_terms:payment.provider,cancel_msg:l10n_ua_payment_liqpay.payment_provider_liqpay
msgid "<span>Your payment has been cancelled.</span>"
msgstr "<span>Ваш платіж скасовано.</span>"

#. module: l10n_ua_payment_liqpay
#: model_terms:payment.provider,pending_msg:l10n_ua_payment_liqpay.payment_provider_liqpay
