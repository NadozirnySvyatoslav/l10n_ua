<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_order_tree" model="ir.ui.view">
        <field name="name">hr.order.tree</field>
        <field name="model">hr.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="order_type"/>
                <field name="employee_id"/>
                <field name="subject"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_order_form" model="ir.ui.view">
        <field name="name">hr.order.form</field>
        <field name="model">hr.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- "New Time Off" — opens a leave form pre-filled from
                         this order so the user reviews and saves it. Shown
                         only on a saved vacation order whose details are
                         complete and that has no time off linked yet;
                         confirming the order never creates one. -->
                    <button name="action_create_leave"
                            type="object"
                            string="New Time Off"
                            class="btn-primary"
                            icon="fa-plus"
                            invisible="not can_create_leave or not id"/>
                    <field name="can_create_leave" invisible="1"/>
                    <button name="action_load_template" string="Load from Template" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state not in ('confirmed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <!-- Time Off smart button — count of the employee's time
                         off records; opens their list. Only for vacation
                         orders. -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leaves" type="object"
                                class="oe_stat_button" icon="fa-plane"
                                invisible="order_type != 'vacation' or leave_count == 0">
                            <field name="leave_count" widget="statinfo"/>
                        </button>
                    </div>
                    <!-- Once a time off is linked, the shared data (type,
                         employee, department, company, dates) must stay
                         identical on both documents, so it is locked here.
                         The subject, the order date and the rendered content
                         stay editable. -->
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="order_type" readonly="bool(leave_id)"/>
                            <field name="date"/>
                            <field name="subject"/>
                            <!-- Audit trail: who recorded the signed order in
                                 the system, and when. -->
                            <field name="confirmed_by_id" invisible="state == 'draft'"/>
                            <field name="confirmed_date" invisible="state == 'draft'"/>
                        </group>
                        <group>
                            <!-- no_open throughout: an order opened from a
                                 leave's "New Order" button is still unsaved,
                                 and navigating to any of these records loses
                                 the leave it was opened from. -->
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True, 'no_open': True}"
                                   readonly="bool(leave_id)"/>
                            <field name="employee_id"
                                   readonly="bool(leave_id)"
                                   options="{'no_open': True}"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            <field name="department_id"
                                   readonly="bool(leave_id)"
                                   options="{'no_open': True}"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            <field name="job_id"
                                   readonly="bool(leave_id)"
                                   options="{'no_open': True}"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            <field name="date_start" invisible="order_type != 'hiring'"/>
                            <field name="is_fixed_term" invisible="order_type != 'hiring'"/>
                            <field name="date_end" invisible="order_type != 'hiring' or not is_fixed_term"/>
                            <field name="employment_form" invisible="order_type != 'hiring'"/>
                            <field name="date_dismissal" invisible="order_type != 'dismissal'"/>
                            <field name="termination_reason_id" invisible="order_type != 'dismissal'"
                                   options="{'no_create': True}"/>
                            <field name="dismissal_reason" invisible="order_type != 'dismissal'"/>
                            <field name="include_vacation_compensation" invisible="order_type != 'dismissal'"/>
                            <field name="unused_vacation_days" invisible="order_type != 'dismissal' or not include_vacation_compensation"/>
                            <field name="work_entry_type_id" invisible="order_type != 'vacation'" required="order_type == 'vacation'" readonly="bool(leave_id)"
                                   options="{'no_open': True}"/>
                            <field name="vacation_date_from" invisible="order_type != 'vacation'" required="order_type == 'vacation'" readonly="bool(leave_id)"/>
                            <field name="vacation_date_to" invisible="order_type != 'vacation'" required="order_type == 'vacation'" readonly="bool(leave_id)"/>
                            <!-- Not shown: the linked time off is reached
                                 through the "Time Off" smart button. Kept in
                                 the view (invisible fields are still saved) so
                                 a default_leave_id passed by the leave form's
                                 "New Order" button survives the save. -->
                            <field name="leave_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_order_search" model="ir.ui.view">
        <field name="name">hr.order.search</field>
        <field name="model">hr.order</field>
        <field name="arch" type="xml">
            <search string="HR Orders">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="order_type"/>
                <separator/>
                <filter string="Hiring" name="hiring" domain="[('order_type', '=', 'hiring')]"/>
                <filter string="Dismissal" name="dismissal" domain="[('order_type', '=', 'dismissal')]"/>
                <filter string="Transfer" name="transfer" domain="[('order_type', '=', 'transfer')]"/>
                <filter string="Vacation" name="vacation" domain="[('order_type', '=', 'vacation')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group>
                    <filter string="Order Type" name="group_type" domain="[]" context="{'group_by': 'order_type'}"/>
                    <filter string="Employee" name="group_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_order" model="ir.actions.act_window">
        <field name="name">Кадрові накази</field>
        <field name="res_model">hr.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Створіть перший кадровий наказ
            </p>
        </field>
    </record>

</odoo>
