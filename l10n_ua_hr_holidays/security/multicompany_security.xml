<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             These models carry company_id but had no multi-company ir.rule,
             so records leaked across ALL companies. Standard Odoo pattern
             (see l10n_ua_account_vat pilot). -->

        <record id="hr_sick_leave_company_rule" model="ir.access">
            <field name="name">Лікарняний: multi-company</field>
            <field name="model_id" ref="model_hr_sick_leave"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

        <record id="hr_vacation_schedule_company_rule" model="ir.access">
            <field name="name">Графік відпусток: multi-company</field>
            <field name="model_id" ref="model_hr_vacation_schedule"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

        <record id="hr_employee_vacation_summary_report_company_rule" model="ir.access">
            <field name="name">Зведений звіт по відпустках: multi-company</field>
            <field name="model_id" ref="model_hr_employee_vacation_summary_report"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

    </data>
</odoo>
