<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_inherit_ua_holidays" model="ir.ui.view">
        <field name="name">res.company.form.inherit.ua.holidays</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Кнопок імпорту видів відпустки більше немає: у Odoo 20
                 hr.work.entry.type прив'язана до країни, тож 15 наших
                 видів приходять з даними модуля на всі компанії. -->
            <xpath expr="//sheet" position="inside">
                <group string="Time Off (UA)" name="l10n_ua_holidays">
                    <field name="l10n_ua_default_leave_type_id"
                           options="{'no_quick_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
