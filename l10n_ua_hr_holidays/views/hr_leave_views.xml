<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_leave_view_form_ua" model="ir.ui.view">
        <field name="name">hr.leave.form.ua</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <!-- "New Order" — opens a vacation order form pre-filled from this
                 leave, styled like the same button on the employee card.
                 Hidden once an order exists or for leave types that do not
                 issue orders. Orders are only ever created this way. -->
            <xpath expr="//header" position="inside">
                <button name="action_create_order"
                        type="object"
                        string="New Order"
                        class="btn-primary"
                        icon="fa-plus"
                        invisible="not can_create_order or not id"/>
            </xpath>

            <!-- Once an order is linked, the data shared with it (leave type
                 and dates; the employee comes from the order too) must stay
                 identical on both documents, so it is locked here. The
                 description and the attachments stay editable. -->
            <xpath expr="//field[@name='work_entry_type_id']" position="attributes">
                <attribute name="readonly">state in ['cancel', 'refuse', 'validate', 'validate1'] or order_id</attribute>
                <!-- no_open: opening the leave type from here navigates away
                     and comes back with a fresh, unsaved record — which loses
                     both the readonly state and, worse, the link to the order
                     the form was opened from. -->
                <attribute name="options">{'no_create': True, 'no_open': True, 'request_type': 'leave'}</attribute>
            </xpath>
            <xpath expr="//field[@name='request_date_from']" position="attributes">
                <attribute name="readonly">state != 'confirm' or order_id</attribute>
            </xpath>

            <!-- A confirmed order is the legal document obliging the employee
                 to take the leave, so the leave can no longer be undone.
                 Approving it stays possible: the order may have been issued
                 first and the leave confirmed only afterwards. -->
            <xpath expr="//button[@name='action_refuse']" position="attributes">
                <attribute name="invisible">not can_refuse or not id or has_confirmed_order</attribute>
            </xpath>
            <xpath expr="//button[@name='action_back_to_approval']" position="attributes">
                <attribute name="invisible">not can_back_to_approve or not id or has_confirmed_order</attribute>
            </xpath>

            <!-- Orders smart button — count of vacation orders for this
                 employee; opens the list of those orders. -->
            <xpath expr="//field[@name='dashboard_warning_message']"
                   position="before">
                <field name="can_create_order" invisible="1"/>
                <field name="has_confirmed_order" invisible="1"/>
                <!-- Not shown to the user (the order is reached through the
                     Orders smart button), but kept in the view so a leave
                     opened from an order's "New Time Off" button carries
                     default_order_id through to the save. -->
                <field name="order_id" invisible="1"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_orders" type="object"
                            class="oe_stat_button" icon="fa-file-text-o"
                            invisible="order_count == 0">
                        <field name="order_count" widget="statinfo"/>
                    </button>
                </div>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Ukrainian Specifics" name="ua_details">
                    <div class="alert alert-warning" role="alert" colspan="2"
                         invisible="not carryover_warning">
                        <field name="carryover_warning" readonly="1" nolabel="1"/>
                    </div>
                    <!-- Advisory only: charging a leave to a period its dates
                         do not cover is allowed, but flag it so a wrongly
                         picked period does not silently distort the balance. -->
                    <div class="alert alert-info" role="alert" colspan="2"
                         invisible="not period_mismatch_warning">
                        <field name="period_mismatch_warning" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <field name="calendar_days"/>
                        <field name="working_days"/>
                        <field name="vacation_year" readonly="1"/>
                        <!-- HR picks the accounting period. On leave-type
                             selection all periods up to today are backfilled
                             and the one containing today is preselected. -->
                        <!-- no_open for the same reason as the leave type:
                             navigating away from an unsaved leave loses the
                             order it was opened from. -->
                        <field name="vacation_balance_id"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="average_daily_salary"/>
                        <field name="vacation_pay_amount"/>
                    </group>
                    <group>
                        <field name="remaining_days_before"/>
                        <field name="remaining_days_after"/>
                    </group>
                    <!-- The linked order is reached through the "Orders" smart
                         button; it is not shown or picked as a field here, so
                         it cannot be re-pointed at an unrelated order. -->
                </group>
            </xpath>
        </field>
    </record>

        <!-- Employee, company and department are NOT in the base leave form: the
         manager form adds them, so the locking and the no_open above never
         reached them. Same treatment here — navigating to those records from
         an unsaved leave loses the order it was opened from, and the three
         are part of the data the leave shares with its order. -->
    <record id="hr_leave_view_form_manager_ua" model="ir.ui.view">
        <field name="name">hr.leave.view.form.manager.ua</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <!-- The base form also carries an invisible employee_id, so match
                 the manager one by its widget rather than by name alone. -->
            <xpath expr="//field[@name='employee_id'][@widget='many2one_avatar_employee']"
                   position="attributes">
                <attribute name="options">{'no_open': True}</attribute>
                <attribute name="readonly">state in ['cancel', 'refuse', 'validate', 'validate1'] or order_id</attribute>
            </xpath>
            <!-- company_id і department_id Odoo 20 прибрало з форми
                 відпустки (лишилися лише в списку), тож налаштовувати
                 їхні атрибути більше нема де. -->
        </field>
    </record>

    <!-- Management > Time Off list.
         The standard list shows date_from / date_to, which are *datetime*
         fields stored in UTC and rendered in the user's timezone. For a
         whole-day leave that makes the edges land on the neighbouring day
         (e.g. 22 Sep 23:00 -> 25 Sep 22:59 in Europe/Kyiv) and no longer
         match the leave form. request_date_from / request_date_to are plain
         Date fields (no time, no timezone), so they always read the same as
         the form. Swap the datetime columns for the Date ones. -->
    <record id="hr_leave_view_tree_ua" model="ir.ui.view">
        <field name="name">hr.leave.tree.ua</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_from']" position="replace">
                <field name="request_date_from" string="Start Date"/>
            </xpath>
            <xpath expr="//field[@name='date_to']" position="replace">
                <field name="request_date_to" string="End Date"/>
            </xpath>
        </field>
    </record>

</odoo>
