<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_vacation_order" model="ir.actions.report">
        <field name="name">Vacation Order</field>
        <field name="model">hr.leave</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_hr_holidays.report_vacation_order</field>
        <field name="report_file">l10n_ua_hr_holidays.report_vacation_order</field>
        <field name="print_report_name">'Наказ_відпустка_%s_%s' % (object.employee_id.name, object.date_from)</field>
        <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_vacation_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="leave">
                <t t-call="l10n_ua_hr_holidays.report_vacation_order_document"/>
            </t>
        </t>
    </template>

    <template id="report_vacation_order_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-family: 'Times New Roman', serif; font-size: 12pt;">
                
                <div style="text-align: center; margin-bottom: 30px;">
                    <strong t-esc="leave.employee_id.company_id.name"/>
                </div>
                
                <div style="text-align: center; margin-bottom: 20px;">
                    <h2 style="margin: 0;">НАКАЗ</h2>
                    <p style="margin: 5px 0;">
                        № <span t-esc="leave.order_number or '___'"/> 
                        від <span t-esc="leave.order_date.strftime('%d.%m.%Y') if leave.order_date else '__.__.____'"/>
                    </p>
                    <p style="margin: 5px 0;">Про надання відпустки</p>
                </div>
                
                <p style="text-indent: 30px; text-align: justify;">
                    Надати <strong><t t-esc="leave.employee_id.name"/></strong>,
                    <t t-if="leave.employee_id.job_id">
                        <t t-esc="leave.employee_id.job_id.name"/>,
                    </t>
                    <t t-if="leave.employee_id.department_id">
                        <t t-esc="leave.employee_id.department_id.name"/>,
                    </t>
                    <strong><t t-esc="leave.holiday_status_id.name"/></strong>
                    тривалістю <strong><t t-esc="leave.calendar_days"/></strong> календарних днів
                    з <strong><t t-esc="leave.date_from.strftime('%d.%m.%Y')"/></strong>
                    по <strong><t t-esc="leave.date_to.strftime('%d.%m.%Y')"/></strong>.
                </p>
                
                <t t-if="leave.vacation_year">
                    <p style="text-indent: 30px;">
                        За робочий рік: <t t-esc="leave.vacation_year"/>
                    </p>
                </t>
                
                <t t-if="leave.holiday_status_id.is_paid and leave.vacation_pay_amount">
                    <p style="text-indent: 30px;">
                        Відпускні: <t t-esc="'{:,.2f}'.format(leave.vacation_pay_amount)"/> грн
                    </p>
                </t>
                
                <p style="margin-top: 30px;">
                    Підстава: заява працівника від __.__.____
                </p>
                
                <div style="margin-top: 50px;">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 50%;">Директор</td>
                            <td style="width: 50%; text-align: right;">
                                _____________ / <t t-esc="leave.employee_id.company_id.director_id.name or '_____________'"/> /
                            </td>
                        </tr>
                    </table>
                </div>
                
                <div style="margin-top: 30px;">
                    <p>З наказом ознайомлений(а):</p>
                    <p style="margin-top: 20px;">
                        _____________ / <t t-esc="leave.employee_id.name"/> /
                        <span style="margin-left: 50px;">«___» _____________ 20__ р.</span>
                    </p>
                </div>
                
            </div>
        </t>
    </template>

</odoo>
