<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_employee_vacation_summary" model="ir.actions.report">
        <field name="name">Vacation Summary</field>
        <field name="model">hr.employee.vacation.summary.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_hr_holidays.report_hr_employee_vacation_summary</field>
        <field name="report_file">l10n_ua_hr_holidays.report_hr_employee_vacation_summary</field>
        <field name="print_report_name">'Підсумок_відпусток_%s' % (object.year)</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="l10n_ua_hr_base.paperformat_a4_ua"/>
    </record>

    <template id="report_hr_employee_vacation_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report_doc">
                <t t-call="l10n_ua_hr_holidays.report_hr_employee_vacation_summary_document"/>
            </t>
        </t>
    </template>

    <template id="report_hr_employee_vacation_summary_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="report_doc.company_id or env.company"/>
            <t t-set="balances" t-value="report_doc.balance_ids"/>
            <div class="page" style="font-family: 'Times New Roman', serif; font-size: 11pt;">

                <div style="text-align: center; margin-bottom: 20px;">
                    <strong t-esc="company.name"/>
                    <h3 style="margin: 10px 0;">ПІДСУМОК ВІДПУСТОК</h3>
                    <p style="font-size: 10pt;">
                        за <span t-esc="report_doc.year"/> рік
                    </p>
                </div>

                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="border: 1px solid #000; padding: 4px; width: 4%;">№</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 22%;">ПІБ</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 16%;">Підрозділ</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 16%;">Тип відпустки</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 7%;">Належить</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 7%;">Перенесено</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 7%;">Всього</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 7%;">Використано</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 7%;">Заплановано</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 7%;">Залишок</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="row_num" t-value="0"/>
                        <t t-foreach="balances" t-as="balance">
                            <t t-set="row_num" t-value="row_num + 1"/>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="row_num"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="balance.employee_id.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="balance.employee_id.department_id.name or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="balance.leave_type_id.name or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="'%g' % (balance.entitled_days or 0)"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="'%g' % (balance.carried_over or 0)"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="'%g' % (balance.total_available or 0)"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="'%g' % (balance.used_days or 0)"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="'%g' % (balance.planned_days or 0)"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="'%g' % (balance.remaining_days or 0)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr style="background-color: #f0f0f0; font-weight: bold;">
                            <td style="border: 1px solid #000; padding: 4px; text-align: right;" colspan="4">
                                Разом:
                            </td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                <t t-esc="'%g' % sum(balances.mapped('entitled_days'))"/>
                            </td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                <t t-esc="'%g' % sum(balances.mapped('carried_over'))"/>
                            </td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                <t t-esc="'%g' % sum(balances.mapped('total_available'))"/>
                            </td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                <t t-esc="'%g' % sum(balances.mapped('used_days'))"/>
                            </td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                <t t-esc="'%g' % sum(balances.mapped('planned_days'))"/>
                            </td>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                <t t-esc="'%g' % sum(balances.mapped('remaining_days'))"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <div style="margin-top: 20px; font-size: 10pt;">
                    <p>Всього працівників у звіті: <strong><t t-esc="report_doc.employee_count"/></strong></p>
                </div>

                <div style="margin-top: 30px;">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 40%;">Керівник кадрової служби</td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: center; font-size: 9pt;">(підпис)</td>
                            <td style="text-align: center; font-size: 9pt;">(П.І.Б.)</td>
                        </tr>
                    </table>
                </div>

            </div>
        </t>
    </template>

</odoo>
