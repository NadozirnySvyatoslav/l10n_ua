<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ua_agreement_view_form_edo" model="ir.ui.view">
        <field name="name">l10n_ua.agreement.form.edo</field>
        <field name="model">l10n_ua.agreement</field>
        <field name="inherit_id" ref="l10n_ua_agreement.l10n_ua_agreement_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_edo_send" type="object" string="Send to EDO"
                        invisible="state not in ('draft', 'to_sign')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_edo_documents" type="object" class="oe_stat_button"
                        icon="fa-exchange" invisible="not edo_document_count">
                    <div class="o_stat_info">
                        <field name="edo_state" class="o_stat_value"/>
                        <span class="o_stat_text">EDO</span>
                    </div>
                    <field name="edo_document_count" invisible="1"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
