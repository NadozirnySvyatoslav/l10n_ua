<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             Models below carry a stored company_id but had no multi-company
             ir.rule, so records leaked across ALL companies. These global
             rules scope each model to the user's allowed companies. -->

        <record id="hr_employee_military_operational_report_company_rule" model="ir.rule">
            <field name="name">Відомість оперативного обліку: multi-company</field>
            <field name="model_id" ref="model_hr_employee_military_operational_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_tariff_grade_company_rule" model="ir.rule">
            <field name="name">Tariff grade: multi-company</field>
            <field name="model_id" ref="model_hr_tariff_grade"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
