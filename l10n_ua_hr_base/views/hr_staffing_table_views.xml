<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_staffing_table_tree" model="ir.ui.view">
        <field name="name">hr.staffing.table.tree</field>
        <field name="model">hr.staffing.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="units"/>
                <field name="filled_units"/>
                <field name="vacant_units"/>
                <field name="salary"/>
                <field name="total_salary_fund"/>
                <field name="date_from"/>
                <field name="date_end"/>
                <field name="date_to" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_staffing_table_form" model="ir.ui.view">
        <field name="name">hr.staffing.table.form</field>
        <field name="model">hr.staffing.table</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <!-- Only a draft may be discarded. An approved line is the record
                         payroll reads: archiving it would hand the position back
                         to the salary of the period before, without a word. An
                         approval made by mistake is undone with "Set to Draft". -->
                    <button name="action_archive" string="Archive" type="object" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state not in ('approved', 'archived')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Position">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="department_id"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            <field name="job_id"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                        </group>
                        <group string="Staff Units">
                            <field name="units"/>
                            <field name="filled_units"/>
                            <field name="vacant_units"/>
                        </group>
                    </group>
                    <group>
                        <group string="Salary">
                            <field name="salary"/>
                            <label for="salary_min" string="Salary Range"/>
                            <div class="o_row">
                                <field name="salary_min" class="oe_inline" placeholder="Min"/>
                                <span class="oe_inline"> - </span>
                                <field name="salary_max" class="oe_inline" placeholder="Max"/>
                            </div>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_salary_fund"/>
                        </group>
                        <group string="Validity">
                            <field name="date_from"/>
                            <!-- Read-only, and derived: a line runs until the
                                 next approved one of the same position starts.
                                 The date that is entered by hand lives with the
                                 order that carries it, below. -->
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="Approval">
                        <field name="order_number"/>
                        <field name="order_date"/>
                        <!-- Not a second end date: this is the order that ends
                             the position itself, after which no line follows.
                             An ordinary line needs nothing here — it is
                             superseded by the next one on its own. -->
                        <field name="date_to"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_staffing_table_search" model="ir.ui.view">
        <field name="name">hr.staffing.table.search</field>
        <field name="model">hr.staffing.table</field>
        <field name="arch" type="xml">
            <search string="Staffing Table">
                <field name="department_id"/>
                <field name="job_id"/>
                <separator/>
                <!-- Approved now spans history: a superseded line keeps its
                     approved state so that a past payslip still resolves to the
                     salary of its own month. "In force" is the one to look at
                     day to day, and the one the printed staffing table needs —
                     summing superseded lines alongside current ones would
                     double the staff units and the payroll fund. Whether a line
                     still applies depends on its siblings, so the filter goes
                     through `is_current` rather than a domain over dates. -->
                <filter string="In Force" name="in_force"
                        domain="[('is_current', '=', True)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter string="Has Vacancies" name="has_vacancies" domain="[('vacant_units', '&gt;', 0)]"/>
            </search>
        </field>
    </record>

    <record id="view_hr_staffing_table_pivot" model="ir.ui.view">
        <field name="name">hr.staffing.table.pivot</field>
        <field name="model">hr.staffing.table</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="department_id" type="row"/>
                <field name="job_id" type="row"/>
                <field name="units" type="measure"/>
                <field name="filled_units" type="measure"/>
                <field name="vacant_units" type="measure"/>
                <field name="total_salary_fund" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hr_staffing_table_kanban" model="ir.ui.view">
        <field name="name">hr.staffing.table.kanban</field>
        <field name="model">hr.staffing.table</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="department_id">
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="units"/>
                <field name="filled_units"/>
                <field name="vacant_units"/>
                <field name="salary"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="job_id"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>Units: <field name="units"/> (Vacant: <field name="vacant_units"/>)</div>
                                <div>Salary: <field name="salary"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'approved': 'success', 'archived': 'secondary'}}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hr_staffing_table" model="ir.actions.act_window">
        <field name="name">Staffing Table</field>
        <field name="res_model">hr.staffing.table</field>
        <field name="view_mode">list,form,pivot,kanban</field>
        <field name="context">{'search_default_in_force': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first staffing table entry
            </p>
            <p>
                Define positions, staff units, and salaries for your organization structure.
            </p>
        </field>
    </record>

</odoo>
