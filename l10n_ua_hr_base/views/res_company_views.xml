<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Реєстраційні реквізити компанії живуть у `l10n_ua_company_base` і
         показуються на власній вкладці. Тут — лише кадрове (#292). -->
    <record id="view_company_form_inherit_ua_hr" model="ir.ui.view">
        <field name="name">res.company.form.inherit.ua.hr</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ukrainian HR" name="ua_hr">
                    <group>
                        <group string="Responsible Persons">
                            <field name="director_id"/>
                            <field name="accountant_id"/>
                            <field name="hr_manager_id"/>
                            <field name="military_officer_id"/>
                        </group>
                        <group string="HR Settings">
                            <field name="wage_from_staffing"/>
                        </group>
                    </group>
                    <group string="Бронювання військовозобов'язаних" name="ua_reservation">
                        <group>
                            <field name="l10n_ua_critical_enterprise"/>
                            <field name="l10n_ua_critical_authority"
                                   invisible="not l10n_ua_critical_enterprise"/>
                            <field name="l10n_ua_critical_decision"
                                   invisible="not l10n_ua_critical_enterprise"/>
                            <field name="l10n_ua_critical_until"
                                   invisible="not l10n_ua_critical_enterprise"/>
                        </group>
                        <group invisible="not l10n_ua_critical_enterprise">
                            <field name="l10n_ua_reservation_limit"/>
                            <field name="l10n_ua_reservation_limit_until"/>
                            <field name="l10n_ua_reservation_base"
                                   invisible="l10n_ua_critical_authority == 'other'"/>
                            <field name="l10n_ua_liable_count"/>
                            <field name="l10n_ua_reserved_count"/>
                            <field name="l10n_ua_reservation_share"
                                   decoration-danger="l10n_ua_reservation_exceeded"/>
                            <field name="l10n_ua_reservation_exceeded" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert"
                         invisible="not l10n_ua_reservation_exceeded">
                        Частка заброньованих перевищує граничну. Протягом 10 робочих днів
                        подайте через «Дію» заяву про анулювання бронювання зайвих працівників
                        (Порядок № 76 у редакції ПКМУ № 1328).
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
