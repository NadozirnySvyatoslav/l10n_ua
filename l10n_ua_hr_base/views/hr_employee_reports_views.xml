            </list>
        </field>
    </record>

    <record id="hr_employee_benefits_report_view_search" model="ir.ui.view">
        <field name="name">hr.employee.benefits.report.search</field>
        <field name="model">hr.employee.benefits.report</field>
        <field name="arch" type="xml">
            <search string="Employees with Benefits Reports">
                <field name="name"/>
                <field name="date"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Generated" name="filter_generated" domain="[('state', '=', 'generated')]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_benefits_report" model="ir.actions.act_window">
        <field name="name">Працівники з пільгами</field>
        <field name="res_model">hr.employee.benefits.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Створіть звіт "Працівники з пільгами"
            </p>
            <p>
                Звіт формує список працівників з інвалідністю, чорнобильською
