                            <field name="company_id" groups="base.group_multi_company"
                                   domain="[('id', 'in', allowed_company_ids)]"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Результат">
                            <field name="employee_count"/>
                            <field name="reserved_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Військовозобов'язані" name="employees">
                            <field name="employee_ids" readonly="1" context="{'active_test': False}">
                                <list>
                                    <field name="name"/>
                                    <field name="birthday" optional="show"/>
                                    <field name="job_id" optional="show"/>
                                    <field name="military_rank_id" optional="show"/>
                                    <field name="military_specialty" optional="show"/>
                                    <field name="military_category" optional="show"/>
                                    <field name="military_fitness" optional="show"/>
                                    <field name="military_tcc_id" optional="show"/>
                                    <field name="military_reservation" optional="show"/>
                                    <field name="military_reservation_until" optional="show"/>
                                    <field name="category_ids" widget="many2many_tags" optional="hide" string="Теги"/>
                                    <field name="departure_date" optional="hide" string="Дата звільнення"/>
                                </list>
                            </field>
                        </page>
                        <page string="Нотатки" name="notes">
                            <field name="notes" placeholder="Додаткові нотатки..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_employee_military_report_view_list" model="ir.ui.view">
        <field name="name">hr.employee.military.report.list</field>
        <field name="model">hr.employee.military.report</field>
        <field name="arch" type="xml">
            <list string="Military Personnel Reports">
                <field name="name"/>
