<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- Employee List Report (Список працівників)               -->
    <!-- ====================================================== -->

    <record id="hr_employee_list_report_view_form" model="ir.ui.view">
        <field name="name">hr.employee.list.report.form</field>
        <field name="model">hr.employee.list.report</field>
        <field name="arch" type="xml">
            <form string="Employee List Report">
                <header>
                    <button name="action_generate" string="Сформувати" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print" string="Друк" type="object"
                            class="btn-secondary" invisible="state != 'generated'"/>
                    <button name="action_draft" string="Редагувати" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Параметри">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   domain="[('id', 'in', allowed_company_ids)]"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Результат">
                            <field name="employee_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Працівники" name="employees">
                            <field name="employee_ids" readonly="1" context="{'active_test': False}">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id" optional="show"/>
                                    <field name="job_id" optional="show"/>
                                    <field name="hire_date" optional="show"/>
                                    <field name="rnokpp" optional="show"/>
                                    <field name="work_phone" optional="show"/>
                                    <field name="work_email" optional="show"/>
                                    <field name="category_ids" widget="many2many_tags" optional="hide" string="Теги"/>
                                    <field name="departure_date" optional="hide" string="Дата звільнення"/>
                                </list>
                            </field>
                        </page>
                        <page string="Нотатки" name="notes">
                            <field name="notes" placeholder="Додаткові нотатки..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_employee_list_report_view_list" model="ir.ui.view">
        <field name="name">hr.employee.list.report.list</field>
        <field name="model">hr.employee.list.report</field>
        <field name="arch" type="xml">
            <list string="Employee List Reports">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'generated'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="hr_employee_list_report_view_search" model="ir.ui.view">
        <field name="name">hr.employee.list.report.search</field>
        <field name="model">hr.employee.list.report</field>
        <field name="arch" type="xml">
            <search string="Employee List Reports">
                <field name="name"/>
                <field name="date"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Generated" name="filter_generated" domain="[('state', '=', 'generated')]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_list_report" model="ir.actions.act_window">
        <field name="name">Список працівників</field>
        <field name="res_model">hr.employee.list.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Створіть звіт "Список працівників"
            </p>
            <p>
                Звіт формує список активних працівників станом на вказану дату
                та дозволяє зберегти його для подальшого перегляду і друку.
            </p>
        </field>
    </record>

    <!-- ====================================================== -->
