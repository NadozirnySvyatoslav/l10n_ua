<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_kp2010_tree" model="ir.ui.view">
        <field name="name">hr.kp2010.tree</field>
        <field name="model">hr.kp2010</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="level"/>
                <field name="parent_id" optional="show"/>
                <field name="group_code" optional="hide"/>
                <field name="work_conditions"/>
            </list>
        </field>
    </record>

    <record id="view_hr_kp2010_hierarchy_tree" model="ir.ui.view">
        <field name="name">hr.kp2010.hierarchy.tree</field>
        <field name="model">hr.kp2010</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Класифікатор професій" default_order="code" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="level"/>
                <field name="work_conditions"/>
            </list>
        </field>
    </record>

    <record id="view_hr_kp2010_form" model="ir.ui.view">
        <field name="name">hr.kp2010.form</field>
        <field name="model">hr.kp2010</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="level" readonly="1"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="group_code"/>
                            <field name="section_code"/>
                            <field name="work_conditions"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Дочірні рівні" invisible="not child_ids">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="level"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_kp2010_search" model="ir.ui.view">
        <field name="name">hr.kp2010.search</field>
        <field name="model">hr.kp2010</field>
        <field name="arch" type="xml">
            <search string="Classifier of Professions">
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id"/>
                <separator/>
                <filter string="Розділи" name="level_1" domain="[('level', '=', '1')]"/>
                <filter string="Підрозділи" name="level_2" domain="[('level', '=', '2')]"/>
                <filter string="Класи" name="level_3" domain="[('level', '=', '3')]"/>
                <filter string="Професії" name="level_4" domain="[('level', '=', '4')]"/>
                <separator/>
                <filter string="Hazardous" name="hazardous" domain="[('work_conditions', '=', 'hazardous')]"/>
                <filter string="Heavy" name="heavy" domain="[('work_conditions', '=', 'heavy')]"/>
                <group>
                    <filter string="За рівнем" name="groupby_level" domain="[]"
                            context="{'group_by': 'level'}"/>
                    <filter string="За батьком" name="groupby_parent" domain="[]"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_kp2010" model="ir.actions.act_window">
        <field name="name">Classifier of Professions (KP 2010)</field>
        <field name="res_model">hr.kp2010</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Import the Classifier of Professions
            </p>
            <p>
                The KP 2010 classifier contains Ukrainian profession codes required for official reporting.
            </p>
        </field>
    </record>

</odoo>
