<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Відомість оперативного обліку призовників, військовозобов'язаних та
         резервістів — додаток 12 до Порядку № 1487. За п. 33 зберігається
         разом зі Списками персонального військового обліку. -->
    <record id="action_report_hr_military_operational" model="ir.actions.report">
        <field name="name">Відомість оперативного обліку (додаток 12)</field>
        <field name="model">hr.employee.military.operational.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_hr_base.report_hr_military_operational</field>
        <field name="print_report_name">'Відомість_оперативного_обліку_%s' % (object.date_to.strftime('%Y%m%d') if object.date_to else time.strftime('%Y%m%d'))</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_a4_ua_landscape"/>
    </record>

    <template id="report_hr_military_operational">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report_doc">
                <t t-call="l10n_ua_hr_base.report_hr_military_operational_document"/>
            </t>
        </t>
    </template>

    <template id="report_hr_military_operational_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="report_doc.company_id or env.company"/>
            <t t-set="rows" t-value="report_doc._get_operational_rows()"/>
            <div class="page" style="font-family: 'Times New Roman', serif; font-size: 9pt;">

                <div style="text-align: right; font-size: 8pt; margin-bottom: 6px;">
                    Додаток 12<br/>
                    до Порядку організації та ведення військового обліку<br/>
                    призовників, військовозобов'язаних та резервістів
                </div>

                <div style="text-align: center; margin-bottom: 10px;">
                    <div style="font-size: 12pt; font-weight: bold;">ВІДОМІСТЬ</div>
                    <div style="font-size: 9pt;">
                        оперативного обліку призовників, військовозобов'язаних
                        та резервістів у
                    </div>
                    <div style="font-size: 9pt; font-weight: bold;">
                        <span t-field="company.name"/>
                    </div>
                    <div style="font-size: 9pt;">
                        станом на <span t-out="report_doc.date_to.strftime('%d.%m.%Y')"/>
                    </div>
                </div>

                <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="border: 1px solid #000; padding: 3px; width: 5%;">Порядковий номер</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 33%;">Найменування групи</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 8%;">Усього</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 11%;">Мають мобілізаційні розпорядження</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 9%;">Заброньовані</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 12%;">Не заброньовані та не мають мобілізаційних розпоряджень</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 11%;">З 1 січня прийнято на роботу, навчання</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 11%;">З 1 січня звільнено з роботи, навчання</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="rows" t-as="row">
                            <tr>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-out="row['number']"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px;">
                                    <t t-out="row['label']"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-out="row['total']"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-out="row['with_mob']"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-out="row['reserved']"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-out="row['free']"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-out="row['hired']"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-out="row['dismissed']"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div style="margin-top: 20px; font-size: 9pt;">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 45%;">Особа, відповідальна за ведення військового обліку</td>
                            <td style="width: 25%; border-bottom: 1px solid #000;"></td>
                            <td style="width: 30%; border-bottom: 1px solid #000; text-align: center;">
                                <t t-out="report_doc.military_officer_id.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: center; font-size: 8pt;">(підпис)</td>
                            <td style="text-align: center; font-size: 8pt;">(ініціали та прізвище)</td>
                        </tr>
                        <tr>
                            <td style="padding-top: 14px;">Керівник</td>
                            <td style="border-bottom: 1px solid #000; vertical-align: bottom;"></td>
                            <td style="border-bottom: 1px solid #000; vertical-align: bottom; text-align: center;">
                                <t t-out="report_doc.director_id.name or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: center; font-size: 8pt;">(підпис)</td>
                            <td style="text-align: center; font-size: 8pt;">(ініціали та прізвище)</td>
                        </tr>
                    </table>
                </div>

            </div>
        </t>
    </template>

</odoo>
