<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_employee_benefits" model="ir.actions.report">
        <field name="name">Employees with Benefits</field>
        <field name="model">hr.employee.benefits.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_hr_base.report_hr_employee_benefits</field>
        <field name="report_file">l10n_ua_hr_base.report_hr_employee_benefits</field>
        <field name="print_report_name">'Працівники_з_пільгами_%s' % (object.date.strftime('%Y%m%d') if object.date else time.strftime('%Y%m%d'))</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_a4_ua"/>
    </record>

    <template id="report_hr_employee_benefits">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report_doc">
                <t t-call="l10n_ua_hr_base.report_hr_employee_benefits_document"/>
            </t>
        </t>
    </template>

    <template id="report_hr_employee_benefits_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="report_doc.company_id or env.company"/>
            <t t-set="employees" t-value="report_doc.with_context(active_test=False).employee_ids"/>
            <div class="page" style="font-family: 'Times New Roman', serif; font-size: 11pt;">

                <div style="text-align: center; margin-bottom: 20px;">
                    <strong t-esc="company.name"/>
                    <h3 style="margin: 10px 0;">СПИСОК ПРАЦІВНИКІВ З ПІЛЬГАМИ</h3>
                    <p style="font-size: 10pt;">
                        станом на <span t-esc="report_doc.date.strftime('%d.%m.%Y')"/>
                    </p>
                </div>

                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="border: 1px solid #000; padding: 4px; width: 4%;">№</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 20%;">ПІБ</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 15%;">Посада</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 12%;">Інвалідність</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 12%;">Чорнобилець</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 12%;">Ветеран</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 25%;">Інші пільги</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="row_num" t-value="0"/>
                        <t t-foreach="employees" t-as="employee">
                            <t t-set="row_num" t-value="row_num + 1"/>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="row_num"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="employee.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="employee.job_id.name or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-if="employee.disability_group and employee.disability_group != 'none'">
                                        Група <t t-esc="employee.disability_group"/>
                                        <t t-if="employee.disability_date_to">
                                            <br/><span style="font-size: 8pt;">до <t t-esc="employee.disability_date_to.strftime('%d.%m.%Y')"/></span>
                                        </t>
                                    </t>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-if="employee.chornobyl_category and employee.chornobyl_category != 'none'">
                                        Категорія <t t-esc="employee.chornobyl_category"/>
                                    </t>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-if="employee.veteran_status == 'combat'">Учасник бойових дій</t>
                                    <t t-if="employee.veteran_status == 'war'">Ветеран війни</t>
                                    <t t-if="employee.veteran_status == 'labor'">Ветеран праці</t>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; font-size: 8pt;">
                                    <t t-foreach="employee.benefit_ids" t-as="benefit">
                                        <t t-esc="benefit.name"/>
                                        <t t-if="not benefit_last">; </t>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div style="margin-top: 20px; font-size: 10pt;">
                    <p>Всього працівників з пільгами: <strong><t t-esc="report_doc.employee_count"/></strong></p>
                    <p>З них: інвалідів — <strong><t t-esc="report_doc.disabled_count"/></strong>,
                       чорнобильців — <strong><t t-esc="report_doc.chornobyl_count"/></strong>,
                       ветеранів — <strong><t t-esc="report_doc.veteran_count"/></strong></p>
                </div>

                <div style="margin-top: 30px;">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 40%;">Керівник кадрової служби</td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: center; font-size: 9pt;">(підпис)</td>
                            <td style="text-align: center; font-size: 9pt;">(П.І.Б.)</td>
                        </tr>
                    </table>
                </div>

            </div>
        </t>
    </template>

</odoo>
