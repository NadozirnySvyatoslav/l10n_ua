<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_employee_military" model="ir.actions.report">
        <field name="name">Military Personnel</field>
        <field name="model">hr.employee.military.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_hr_base.report_hr_employee_military</field>
        <field name="report_file">l10n_ua_hr_base.report_hr_employee_military</field>
        <field name="print_report_name">'Військовозобовязані_%s' % (object.date.strftime('%Y%m%d') if object.date else time.strftime('%Y%m%d'))</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_a4_ua"/>
    </record>

    <template id="report_hr_employee_military">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report_doc">
                <t t-call="l10n_ua_hr_base.report_hr_employee_military_document"/>
            </t>
        </t>
    </template>

    <template id="report_hr_employee_military_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="report_doc.company_id or env.company"/>
            <t t-set="employees" t-value="report_doc.employee_ids"/>
            <div class="page" style="font-family: 'Times New Roman', serif; font-size: 11pt;">

                <div style="text-align: center; margin-bottom: 20px;">
                    <strong t-esc="company.name"/>
                    <h3 style="margin: 10px 0;">СПИСОК ВІЙСЬКОВОЗОБОВ'ЯЗАНИХ</h3>
                    <p style="font-size: 10pt;">
                        станом на <span t-esc="report_doc.date.strftime('%d.%m.%Y')"/>
                    </p>
                </div>

                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="border: 1px solid #000; padding: 3px; width: 3%;">№</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 15%;">ПІБ</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 8%;">Дата народж.</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 11%;">Посада</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 9%;">Звання</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 6%;">ВОС</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 8%;">Категорія обліку</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 8%;">Придатність</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 5%;">Мед. кат.</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 7%;">ВЛК до</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 10%;">ТЦК</th>
                            <th style="border: 1px solid #000; padding: 3px; width: 10%;">Бронювання</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="row_num" t-value="0"/>
                        <t t-foreach="employees" t-as="employee">
                            <t t-set="row_num" t-value="row_num + 1"/>
                            <tr>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-esc="row_num"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px;">
                                    <t t-esc="employee.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-if="employee.birthday">
                                        <t t-esc="employee.birthday.strftime('%d.%m.%Y')"/>
                                    </t>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px;">
                                    <t t-esc="employee.job_id.name or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px;">
                                    <t t-esc="employee.military_rank_id.name or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-esc="employee.military_specialty or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-if="employee.military_register_category == 'conscript'">Призовник</t>
                                    <t t-if="employee.military_register_category == 'liable'">В/зобов.</t>
                                    <t t-if="employee.military_register_category == 'reservist'">Резервіст</t>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-if="employee.military_fitness == 'fit'">Придатний</t>
                                    <t t-if="employee.military_fitness == 'fit_support'">Заб. частини</t>
                                    <t t-if="employee.military_fitness == 'temp_unfit'">Тимч. непр.</t>
                                    <t t-if="employee.military_fitness == 'unfit'">Непридатний</t>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-esc="employee.military_medical_category or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-if="employee.military_mlk_retest_date">
                                        <t t-esc="employee.military_mlk_retest_date.strftime('%d.%m.%y')"/>
                                    </t>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; font-size: 8pt;">
                                    <t t-esc="employee.military_tcc_id.name or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                    <t t-if="employee.military_reservation">
                                        <t t-if="employee.military_reservation_until">
                                            до <t t-esc="employee.military_reservation_until.strftime('%d.%m.%y')"/>
                                        </t>
                                        <t t-else="">Так</t>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div style="margin-top: 20px; font-size: 10pt;">
                    <p>Всього військовозобов'язаних: <strong><t t-esc="report_doc.employee_count"/></strong></p>
                    <p>З них заброньовано: <strong><t t-esc="report_doc.reserved_count"/></strong></p>
                </div>

                <div style="margin-top: 30px;">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 40%;">Відповідальний за військовий облік</td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: center; font-size: 9pt;">(підпис)</td>
                            <td style="text-align: center; font-size: 9pt;">(П.І.Б.)</td>
                        </tr>
                    </table>
                </div>

            </div>
        </t>
    </template>

</odoo>
