<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_vacancies" model="ir.actions.report">
        <field name="name">Vacancies</field>
        <field name="model">hr.staffing.table</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_hr_base.report_hr_vacancies</field>
        <field name="print_report_name">'Вакансії_%s' % (time.strftime('%Y%m%d'))</field>
        <field name="binding_model_id" ref="model_hr_staffing_table"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_a4_ua"/>
    </record>

    <template id="report_hr_vacancies">
        <t t-call="web.html_container">
            <t t-call="l10n_ua_hr_base.report_hr_vacancies_document"/>
        </t>
    </template>

    <template id="report_hr_vacancies_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="docs[0].company_id if docs else env.company"/>
            <t t-set="vacancies" t-value="[r for r in docs if r.vacant_units > 0]"/>
            <div class="page" style="font-family: 'Times New Roman', serif; font-size: 11pt;">
                
                <div style="text-align: center; margin-bottom: 20px;">
                    <strong t-esc="company.name"/>
                    <h3 style="margin: 10px 0;">ПЕРЕЛІК ВАКАНСІЙ</h3>
                    <p style="font-size: 10pt;">
                        станом на <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y')"/>
                    </p>
                </div>
                
                <table style="width: 100%; border-collapse: collapse; font-size: 10pt;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="border: 1px solid #000; padding: 5px; width: 5%;">№</th>
                            <th style="border: 1px solid #000; padding: 5px; width: 25%;">Підрозділ</th>
                            <th style="border: 1px solid #000; padding: 5px; width: 30%;">Посада</th>
                            <th style="border: 1px solid #000; padding: 5px; width: 15%;">Вакантних одиниць</th>
                            <th style="border: 1px solid #000; padding: 5px; width: 25%;">Оклад, грн</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="row_num" t-value="0"/>
                        <t t-set="total_vacancies" t-value="0"/>
                        <t t-foreach="vacancies" t-as="record">
                            <t t-set="row_num" t-value="row_num + 1"/>
                            <t t-set="total_vacancies" t-value="total_vacancies + record.vacant_units"/>
                            <tr>
                                <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                    <t t-esc="row_num"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px;">
                                    <t t-esc="record.department_id.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px;">
                                    <t t-esc="record.job_id.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                    <t t-esc="record.vacant_units"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px; text-align: right;">
                                    <t t-esc="'{:,.2f}'.format(record.salary)"/>
                                </td>
                            </tr>
                        </t>
                        <tr style="background-color: #f0f0f0; font-weight: bold;">
                            <td colspan="3" style="border: 1px solid #000; padding: 5px; text-align: right;">
                                РАЗОМ вакансій:
                            </td>
                            <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                <t t-esc="total_vacancies"/>
                            </td>
                            <td style="border: 1px solid #000; padding: 5px;"></td>
                        </tr>
                    </tbody>
                </table>
                
                <div style="margin-top: 30px;">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 40%;">Керівник кадрової служби</td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: center; font-size: 9pt;">(підпис)</td>
                            <td style="text-align: center; font-size: 9pt;">(П.І.Б.)</td>
                        </tr>
                    </table>
                </div>
                
            </div>
        </t>
    </template>

</odoo>
