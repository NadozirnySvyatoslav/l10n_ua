<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edo_account_form" model="ir.ui.view">
        <field name="name">l10n_ua.edo.account.form</field>
        <field name="model">l10n_ua.edo.account</field>
        <field name="arch" type="xml">
            <form string="EDO Account">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary" invisible="not provider"/>
                    <button name="action_sync" type="object" string="Synchronise Now" invisible="not provider"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-files-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Вчасно — основна компанія"/></h1></div>
                    <group>
                        <group>
                            <field name="provider"/>
                            <field name="token" password="True" groups="base.group_system"/>
                            <field name="edrpou"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="incoming_date_from"/>
                            <field name="last_sync"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not last_error">
                        <strong>Last synchronisation failed:</strong> <field name="last_error" class="d-inline"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_edo_account_list" model="ir.ui.view">
        <field name="name">l10n_ua.edo.account.list</field>
        <field name="model">l10n_ua.edo.account</field>
        <field name="arch" type="xml">
            <list string="EDO Accounts">
                <field name="name"/>
                <field name="provider"/>
                <field name="edrpou"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="action_edo_account" model="ir.actions.act_window">
        <field name="name">EDO Accounts</field>
        <field name="res_model">l10n_ua.edo.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect an EDO service</p>
            <p>Install the module of the service (e.g. Вчасно), then add its API token here.</p>
        </field>
    </record>
</odoo>
