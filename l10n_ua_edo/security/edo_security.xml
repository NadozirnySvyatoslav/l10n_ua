<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edo_account_company_rule" model="ir.rule">
        <field name="name">EDO account: multi-company</field>
        <field name="model_id" ref="model_l10n_ua_edo_account"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="edo_document_company_rule" model="ir.rule">
        <field name="name">EDO document: multi-company</field>
        <field name="model_id" ref="model_l10n_ua_edo_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="edo_category_company_rule" model="ir.rule">
        <field name="name">EDO category: multi-company</field>
        <field name="model_id" ref="model_l10n_ua_edo_category"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="edo_category_rule_company_rule" model="ir.rule">
        <field name="name">EDO category of a report: multi-company</field>
        <field name="model_id" ref="model_l10n_ua_edo_category_rule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
