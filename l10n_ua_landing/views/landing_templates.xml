            <style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --ink: #0f2233; --blue: #2980b9; --blue-d: #1a5276;
    --bg: #f7fafc; --card: #ffffff; --muted: #5b7185; --accent: #16a085;
  }
  body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.6; }
  a { color: inherit; text-decoration: none; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }

  nav { position: sticky; top: 0; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); border-bottom: 1px solid #e3eaf0; z-index: 10; }
  nav .wrap { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { font-weight: 800; font-size: 22px; letter-spacing: -.5px; }
  .brand span { color: var(--blue); }
  .nav-links { display: flex; align-items: center; gap: 18px; }
  .nav-link { font-weight: 600; font-size: 14px; color: var(--muted); }
  .nav-cta { background: var(--blue); color: #fff; padding: 9px 18px; border-radius: 8px; font-weight: 600; font-size: 14px; }

  .hero { background: linear-gradient(135deg, var(--blue-d) 0%, var(--blue) 100%); color: #fff; padding: 84px 0 96px; text-align: center; }
  .hero h1 { font-size: 44px; line-height: 1.15; letter-spacing: -1px; }
  .hero p { font-size: 20px; opacity: .92; margin: 18px auto 0; max-width: 680px; }
  .hero .btns { margin-top: 32px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .btn { padding: 13px 26px; border-radius: 10px; font-weight: 600; font-size: 15px; }
  .btn-light { background: #fff; color: var(--blue-d); }
  .btn-ghost { border: 1px solid rgba(255,255,255,.6); color: #fff; }
  .hero .hint { margin-top: 16px; font-size: 13px; opacity: .8; }
  .hero .hint code { background: rgba(255,255,255,.16); padding: 2px 7px; border-radius: 5px; font-size: 13px; }

  .stats { display: flex; flex-wrap: wrap; gap: 16px; margin-top: -52px; }
  .stat { flex: 1 1 200px; background: var(--card); border-radius: 14px; padding: 24px; text-align: center; box-shadow: 0 8px 24px rgba(15,34,51,.08); }
  .stat b { display: block; font-size: 34px; color: var(--blue-d); }
  .stat span { color: var(--muted); font-size: 14px; }

  section { padding: 64px 0; }
  h2 { font-size: 30px; text-align: center; letter-spacing: -.5px; }
  .sub { text-align: center; color: var(--muted); margin: 10px auto 0; max-width: 620px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px,1fr)); gap: 16px; margin-top: 40px; }
  .card { background: var(--card); border: 1px solid #e7eef4; border-radius: 14px; padding: 22px; transition: transform .15s, box-shadow .15s; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(15,34,51,.10); }
  .card .ic { font-size: 26px; }
  .card h3 { font-size: 17px; margin: 10px 0 6px; }
  .card p { font-size: 14px; color: var(--muted); }
  .card .n { font-size: 12px; color: var(--accent); font-weight: 700; }

  .features { background: #eef4f9; }
  .frow { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 40px; }
  .feat { flex: 1 1 300px; background: var(--card); border-radius: 14px; padding: 24px; border-left: 4px solid var(--blue); }
  .feat h3 { font-size: 18px; color: var(--blue-d); }
  .feat p { color: var(--muted); font-size: 15px; margin-top: 6px; }

  .cta { background: linear-gradient(135deg, #16252f 0%, #1a5276 100%); color: #fff; text-align: center; border-radius: 20px; padding: 56px 24px; }
  .cta h2 { color: #fff; }
  .cta p { opacity: .9; margin-top: 10px; }

  footer { background: #0f2233; color: #b7c4d0; padding: 56px 0 0; margin-top: 24px; }
  .fcols { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 32px; }
  .fbrand { font-weight: 800; font-size: 22px; color: #fff; }
  .fbrand span { color: var(--blue); }
  .fcol h4 { color: #fff; font-size: 15px; margin-bottom: 12px; letter-spacing: .3px; }
  .fcol a { display: block; color: #b7c4d0; font-size: 14px; padding: 4px 0; transition: color .15s; }
  .fcol a:hover { color: #fff; }
  .fcol p { font-size: 14px; color: #8ba0b3; margin-top: 12px; max-width: 280px; }
  .fcol p b { color: #cbd6e0; }
  .fbar { border-top: 1px solid rgba(255,255,255,.10); margin-top: 40px; padding: 22px 0; font-size: 13px; color: #8ba0b3; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }

  @media (max-width: 760px) { .fcols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .hero h1 { font-size: 32px; } .hero p { font-size: 17px; } }
  @media (max-width: 460px) { .fcols { grid-template-columns: 1fr; } }
            </style>
