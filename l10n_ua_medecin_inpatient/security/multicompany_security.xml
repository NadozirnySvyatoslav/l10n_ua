<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Медичні дані стаціонару видимі лише в межах дозволених компаній
             (за зразком l10n_ua_medecin_clinical, issue #178). -->
        <record id="l10n_ua_medecin_admission_company_rule" model="ir.rule">
            <field name="name">Епізод стаціонарного лікування: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_medecin_admission"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="l10n_ua_medecin_department_company_rule" model="ir.rule">
            <field name="name">Відділення стаціонару: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_medecin_department"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>
