<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="l10n_ua_medecin_bed_company_rule" model="ir.rule">
            <field name="name">Ліжко стаціонару: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_medecin_bed"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="l10n_ua_medecin_admission_transfer_company_rule" model="ir.rule">
            <field name="name">Переведення між відділеннями: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_medecin_admission_transfer"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>
