<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             Кошторис має company_id, але без rule був видимий через усі
             компанії. Рядок кошторису має stored related company_id — теж
             гейтуємо, бо доступний напряму. -->

        <record id="l10n_ua_budget_estimate_company_rule" model="ir.access">
            <field name="name">Кошторис: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_budget_estimate"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

        <record id="l10n_ua_budget_estimate_line_company_rule" model="ir.access">
            <field name="name">Рядок кошторису: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_budget_estimate_line"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

    </data>
</odoo>
