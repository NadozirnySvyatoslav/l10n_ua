<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_benefit_category_list" model="ir.ui.view">
        <field name="name">l10n_ua.meal.benefit.category.list</field>
        <field name="model">l10n_ua.meal.benefit.category</field>
        <field name="arch" type="xml">
            <list string="Пільгові категорії харчування" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="legal_basis"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_benefit_category" model="ir.actions.act_window">
        <field name="name">Пільгові категорії харчування</field>
        <field name="res_model">l10n_ua.meal.benefit.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_contingent_member_form_meals" model="ir.ui.view">
        <field name="name">l10n_ua.education.contingent.member.form.meals</field>
        <field name="model">l10n_ua.education.contingent.member</field>
        <field name="inherit_id" ref="l10n_ua_education_base.view_l10n_ua_education_contingent_member_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Харчування" name="meals">
                    <field name="meal_benefit_ids">
                        <list editable="bottom">
                            <field name="category_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="document"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_company_form_meals" model="ir.ui.view">
        <field name="name">res.company.form.education.meals</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_ua_education_base.view_res_company_form_education"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='ua_education']" position="inside">
                <group string="Харчування" invisible="not l10n_ua_education_type">
                    <field name="l10n_ua_meal_universal_scope"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
