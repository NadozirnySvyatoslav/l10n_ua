<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="l10n_ua_meal_attendance_company_rule" model="ir.rule">
            <field name="name">Відвідуваність харчування: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_meal_attendance"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
        <record id="l10n_ua_meal_attendance_line_company_rule" model="ir.rule">
            <field name="name">Поіменний облік харчування: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_meal_attendance_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
        <record id="l10n_ua_meal_benefit_company_rule" model="ir.rule">
            <field name="name">Пільги на харчування: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_meal_benefit"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>
