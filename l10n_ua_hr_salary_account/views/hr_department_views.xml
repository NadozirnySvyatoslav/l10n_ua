<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_department_form_inherit_salary_account" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.salary.account</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='company_id']" position="after">
                <field name="salary_expense_account_id"/>
                <field name="salary_analytic_distribution"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>

</odoo>
