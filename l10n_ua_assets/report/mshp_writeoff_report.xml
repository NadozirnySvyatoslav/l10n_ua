<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- МШП Write-off Act Report Action -->
    <record id="action_report_mshp_writeoff" model="ir.actions.report">
        <field name="name">Акт списання МШП</field>
        <field name="model">l10n_ua.mshp</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_assets.report_mshp_writeoff_document</field>
        <field name="print_report_name">'Акт_списання_МШП_%s' % (object.writeoff_act_number or object.name)</field>
        <field name="binding_model_id" ref="model_l10n_ua_mshp"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="l10n_ua_doc_reports.paperformat_ua_report"/>
    </record>

    <!-- МШП Write-off Act Template -->
    <template id="report_mshp_writeoff_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <t t-set="company" t-value="o.company_id"/>
                        <t t-set="comp_partner" t-value="company.partner_id"/>

                        <!-- Company header -->
                        <div class="company-header">
                            <div class="company-name" t-field="company.name"/>
                            <t t-if="comp_partner.company_registry">
                                <div class="company-code">
                                    ЄДРПОУ: <span t-field="comp_partner.company_registry"/>
                                </div>
                            </t>
                        </div>

                        <!-- Title -->
                        <div class="ua-report-title" style="margin: 20px 0 5px 0;">
                            АКТ<br/>
                            <span style="font-size: 12pt;">списання малоцінних швидкозношуваних предметів</span>
                        </div>
                        <div style="text-align: center; margin-bottom: 20px;">
                            <span>№ </span><span t-field="o.writeoff_act_number"/>
                            <span> від </span>
                            <span t-field="o.writeoff_date"
                                  t-options='{"format": "dd.MM.yyyy"}'/>
                        </div>

                        <table class="table table-sm table-bordered" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>Найменування</th>
                                    <th class="text-end">Кількість</th>
                                    <th class="text-end">Ціна</th>
                                    <th class="text-end">Вартість</th>
                                    <th>МВО</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td t-field="o.name"/>
                                    <td class="text-end" t-field="o.quantity"/>
                                    <td class="text-end"
                                        t-field="o.unit_cost"
                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    <td class="text-end"
                                        t-field="o.total_cost"
                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    <td t-field="o.employee_id.name"/>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="o.writeoff_reason">
                            <p><strong>Причина списання:</strong>
                                <span t-field="o.writeoff_reason"/></p>
                        </t>
                        <t t-if="o.transfer_number">
                            <p>Передано в експлуатацію за документом
                                <span t-field="o.transfer_number"/> від
                                <span t-field="o.date"
                                      t-options='{"format": "dd.MM.yyyy"}'/>.</p>
                        </t>

                        <div style="margin-top: 40px;">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 50%;">МВО: _______________</td>
                                    <td style="width: 50%; text-align: right;">
                                        Головний бухгалтер: _______________</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
