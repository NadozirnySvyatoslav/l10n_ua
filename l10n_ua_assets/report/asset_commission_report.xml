<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Asset Commissioning Act Report Action -->
    <record id="action_report_asset_commission" model="ir.actions.report">
        <field name="name">Акт введення ОЗ в експлуатацію</field>
        <field name="model">l10n_ua.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_assets.report_asset_commission_document</field>
        <field name="print_report_name">'Акт_введення_%s' % (object.commission_act_number or object.name)</field>
        <field name="binding_model_id" ref="model_l10n_ua_asset"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="l10n_ua_doc_reports.paperformat_ua_report"/>
    </record>

    <!-- Commissioning Act Template -->
    <template id="report_asset_commission_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <t t-set="company" t-value="o.company_id"/>
                        <t t-set="comp_partner" t-value="company.partner_id"/>

                        <!-- Company header -->
                        <div class="company-header">
                            <div class="company-name" t-field="company.name"/>
                            <div class="small">(найменування підприємства)</div>
                            <t t-if="comp_partner.edrpou">
                                <div class="company-code">
                                    ЄДРПОУ: <span t-field="comp_partner.edrpou"/>
                                </div>
                            </t>
                        </div>

                        <!-- Title -->
                        <div class="ua-report-title" style="margin: 20px 0 5px 0;">
                            АКТ<br/>
                            <span style="font-size: 12pt;">введення основних засобів в експлуатацію</span>
                        </div>

                        <!-- Act number and date -->
                        <div class="text-center" style="margin-bottom: 15px; font-size: 11pt;">
                            № <strong t-esc="o.commission_act_number or '___'"/>
                            від
                            <t t-if="o.commission_date">
                                <span t-field="o.commission_date" t-options='{"widget": "date"}'/>
                            </t>
                            <t t-else="">«___» ___________ 20__ р.</t>
                        </div>

                        <!-- Commission info -->
                        <div style="margin-bottom: 15px;">
                            <p>
                                Комісія у складі: голова комісії — ________________________,
                                члени комісії — ________________________, ________________________
                            </p>
                            <p>
                                призначена наказом від «___» ___________ 20__ р. № ______,
                                оглянула прийнятий об'єкт основних засобів і встановила:
                            </p>
                        </div>

                        <!-- Asset details table -->
                        <table class="mb-3" style="width: 100%;">
                            <tr>
                                <th style="width: 5%;">№</th>
                                <th style="width: 30%;">Найменування об'єкта</th>
                                <th style="width: 15%;">Інвентарний №</th>
                                <th style="width: 15%;">Група ОЗ</th>
                                <th style="width: 15%;">Первісна вартість, грн</th>
                                <th style="width: 20%;">Строк корисного використання</th>
                            </tr>
                            <tr>
                                <td class="text-center">1</td>
                                <td><strong t-field="o.name"/></td>
                                <td class="text-center" t-esc="o.inventory_number or '—'"/>
                                <td class="text-center" t-esc="o.group_id.code if o.group_id else '—'"/>
                                <td class="text-right"><span t-esc="'%.2f' % o.original_value"/></td>
                                <td class="text-center">
                                    <span t-esc="o.useful_life"/> міс.
                                    (<span t-esc="'%.1f' % (o.useful_life / 12)"/> р.)
                                </td>
                            </tr>
                        </table>

                        <!-- Depreciation info -->
                        <table class="no-border-all mb-3" style="width: 100%;">
                            <tr>
                                <td style="width: 40%;">Метод амортизації:</td>
                                <td><span t-esc="o._get_depreciation_method_name()"/></td>
                            </tr>
                            <tr>
                                <td>Ліквідаційна вартість:</td>
                                <td><span t-esc="'%.2f' % o.salvage_value"/> грн.</td>
                            </tr>
                            <tr>
                                <td>Місцезнаходження:</td>
                                <td><span t-esc="o.location or '________________________'"/></td>
                            </tr>
                            <tr>
                                <td>Матеріально відповідальна особа:</td>
                                <td><span t-esc="o.responsible_id.name if o.responsible_id else '________________________'"/></td>
                            </tr>
                        </table>

                        <!-- Conclusion -->
                        <div style="margin: 15px 0;">
                            <p>
                                Об'єкт основних засобів відповідає технічним умовам і
                                придатний до експлуатації.
                            </p>
                            <p>
                                Рішення комісії: ввести в експлуатацію з
                                <t t-if="o.commission_date">
                                    <span t-field="o.commission_date" t-options='{"widget": "date"}'/>
                                </t>
                                <t t-else="">«___» ___________ 20__ р.</t>
                            </p>
                        </div>

                        <!-- Signatures -->
                        <div style="margin-top: 30px;">
                            <table class="no-border-all" style="width: 100%;">
                                <tr>
                                    <td style="width: 35%;">Голова комісії</td>
                                    <td style="width: 30%; border-bottom: 1px solid black;"></td>
                                    <td style="width: 5%;"></td>
                                    <td style="width: 30%; border-bottom: 1px solid black;"></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                                <tr><td colspan="4" style="height: 15px;"></td></tr>
                                <tr>
                                    <td>Члени комісії</td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                                <tr><td colspan="4" style="height: 15px;"></td></tr>
                                <tr>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                                <tr><td colspan="4" style="height: 15px;"></td></tr>
                                <tr>
                                    <td>МВО (прийняв)</td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;">
                                        <span t-esc="o.responsible_id.name if o.responsible_id else ''"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
