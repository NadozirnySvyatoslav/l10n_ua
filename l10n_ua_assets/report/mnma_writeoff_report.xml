<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MNMA Write-off Act Report Action -->
    <record id="action_report_mnma_writeoff" model="ir.actions.report">
        <field name="name">Акт списання МНМА</field>
        <field name="model">l10n_ua.mnma</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_assets.report_mnma_writeoff_document</field>
        <field name="print_report_name">'Акт_списання_МНМА_%s' % (object.writeoff_act_number or object.name)</field>
        <field name="binding_model_id" ref="model_l10n_ua_mnma"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="l10n_ua_doc_reports.paperformat_ua_report"/>
    </record>

    <!-- MNMA Write-off Act Template -->
    <template id="report_mnma_writeoff_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <t t-set="company" t-value="o.company_id"/>
                        <t t-set="comp_partner" t-value="company.partner_id"/>

                        <!-- Company header -->
                        <div class="company-header">
                            <div class="company-name" t-field="company.name"/>
                            <t t-if="comp_partner.edrpou">
                                <div class="company-code">
                                    ЄДРПОУ: <span t-field="comp_partner.edrpou"/>
                                </div>
                            </t>
                        </div>

                        <!-- Title -->
                        <div class="ua-report-title" style="margin: 20px 0 5px 0;">
                            АКТ<br/>
                            <span style="font-size: 12pt;">списання малоцінних необоротних матеріальних активів</span>
                        </div>

                        <div class="text-center" style="margin-bottom: 15px; font-size: 11pt;">
                            № <strong t-out="o.writeoff_act_number or '___'"/>
                            від
                            <t t-if="o.writeoff_date">
                                <span t-field="o.writeoff_date" t-options='{"widget": "date"}'/>
                            </t>
                            <t t-else="">«___» ___________ 20__ р.</t>
                        </div>

                        <!-- Details table -->
                        <table class="mb-3" style="width: 100%;">
                            <tr>
                                <th style="width: 5%;">№</th>
                                <th style="width: 25%;">Найменування</th>
                                <th style="width: 12%;">Інвент. №</th>
                                <th style="width: 12%;">Дата введення</th>
                                <th style="width: 12%;">Первісна вартість</th>
                                <th style="width: 10%;">Знос</th>
                                <th style="width: 12%;">Залишкова вартість</th>
                                <th style="width: 12%;">Метод</th>
                            </tr>
                            <tr>
                                <td class="text-center">1</td>
                                <td><strong t-field="o.name"/></td>
                                <td class="text-center" t-out="o.inventory_number or '—'"/>
                                <td class="text-center">
                                    <t t-if="o.commission_date">
                                        <span t-field="o.commission_date" t-options='{"widget": "date"}'/>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                                <td class="text-right"><span t-out="'%.2f' % o.original_value"/></td>
                                <td class="text-right"><span t-out="'%.2f' % o.depreciation_value"/></td>
                                <td class="text-right"><span t-out="'%.2f' % o.residual_value"/></td>
                                <td class="text-center">
                                    <t t-if="o.write_off_method == '50_50'">50/50</t>
                                    <t t-else="">100%</t>
                                </td>
                            </tr>
                        </table>

                        <!-- Write-off reason -->
                        <div class="mb-3">
                            <div class="bold" style="margin-bottom: 5px;">Причина списання:</div>
                            <div style="border-bottom: 1px solid black; min-height: 40px; padding: 3px;">
                                <span t-out="o.writeoff_reason or ''"/>
                            </div>
                        </div>

                        <!-- Signatures -->
                        <div style="margin-top: 30px;">
                            <table class="no-border-all" style="width: 100%;">
                                <tr>
                                    <td style="width: 35%;">Відповідальна особа</td>
                                    <td style="width: 25%; border-bottom: 1px solid black;"></td>
                                    <td style="width: 10%;"></td>
                                    <td style="width: 30%; border-bottom: 1px solid black;">
                                        <span t-out="o.responsible_id.name if o.responsible_id else ''"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                                <tr><td colspan="4" style="height: 15px;"></td></tr>
                                <tr>
                                    <td>Головний бухгалтер</td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
