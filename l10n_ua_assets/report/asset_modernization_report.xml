<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_asset_modernization" model="ir.actions.report">
        <field name="name">Акт прийому-передачі модернізації</field>
        <field name="model">l10n_ua.asset.modernization</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_assets.report_asset_modernization_document</field>
        <field name="report_file">l10n_ua_assets.report_asset_modernization_document</field>
        <field name="print_report_name">'Акт_модернізації_%s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_l10n_ua_asset_modernization"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="l10n_ua_doc_reports.paperformat_ua_report"/>
    </record>

    <template id="report_asset_modernization_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <t t-set="company" t-value="o.company_id"/>
                        <t t-set="comp_partner" t-value="company.partner_id"/>

                        <!-- Company header -->
                        <div class="company-header">
                            <div class="company-name" t-field="company.name"/>
                            <div class="small">(найменування підприємства)</div>
                            <t t-if="comp_partner.company_registry">
                                <div class="company-code">
                                    ЄДРПОУ: <span t-field="comp_partner.company_registry"/>
                                </div>
                            </t>
                        </div>

                        <!-- Title -->
                        <div class="ua-report-title" style="margin: 20px 0 5px 0;">
                            АКТ<br/>
                            <span style="font-size: 12pt;">прийому-передачі робіт з модернізації / реконструкції основних засобів</span>
                        </div>

                        <!-- Number and date -->
                        <div class="text-center" style="margin-bottom: 15px; font-size: 11pt;">
                            № <strong t-esc="o.name"/>
                            від
                            <span t-field="o.date" t-options='{"widget": "date"}'/>
                        </div>

                        <!-- Commission preamble -->
                        <div style="margin-bottom: 15px;">
                            <p>
                                Комісія у складі: голова комісії — ________________________,
                                члени комісії — ________________________, ________________________
                            </p>
                            <p>
                                провела прийом виконаних робіт з модернізації /
                                реконструкції основних засобів станом на
                                <strong><span t-field="o.date" t-options='{"widget": "date"}'/></strong>.
                            </p>
                            <t t-if="o.document_reference">
                                <p>
                                    Документ-підстава: <strong t-esc="o.document_reference"/>.
                                </p>
                            </t>
                        </div>

                        <!-- Lines table -->
                        <table style="width: 100%; font-size: 10pt;">
                            <thead>
                                <tr>
                                    <th style="width: 4%;">№</th>
                                    <th style="width: 30%;">Найменування</th>
                                    <th style="width: 10%;">Інв. №</th>
                                    <th style="width: 24%;">Опис робіт</th>
                                    <th style="width: 11%;">Первісна до</th>
                                    <th style="width: 10%;">Сума</th>
                                    <th style="width: 11%;">Первісна після</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center"><span t-esc="line_index + 1"/></td>
                                        <td><span t-esc="line.asset_id.name"/></td>
                                        <td class="text-center" t-esc="line.asset_id.inventory_number or '—'"/>
                                        <td><span t-esc="line.work_description or '—'"/></td>
                                        <td class="text-right">
                                            <span t-esc="'%.2f' % line.original_value_before"/>
                                        </td>
                                        <td class="text-right">
                                            <strong t-esc="'%.2f' % line.amount"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="'%.2f' % line.original_value_after"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr style="font-weight: bold;">
                                    <td colspan="5" class="text-right">Разом:</td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % o.total_amount"/>
                                    </td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="o.description">
                            <div style="margin: 15px 0;">
                                <strong>Опис робіт:</strong>
                                <p t-esc="o.description"/>
                            </div>
                        </t>

                        <!-- Useful life extensions if any -->
                        <t t-set="has_life_ext" t-value="any(l.useful_life_extension for l in o.line_ids)"/>
                        <t t-if="has_life_ext">
                            <div style="margin: 15px 0;">
                                <strong>Подовження строку корисного використання:</strong>
                                <table style="width: 100%; font-size: 10pt;">
                                    <tr>
                                        <th>ОЗ</th>
                                        <th class="text-right">Строк до (міс.)</th>
                                        <th class="text-right">+ Місяців</th>
                                        <th class="text-right">Строк після (міс.)</th>
                                    </tr>
                                    <t t-foreach="o.line_ids.filtered(lambda l: l.useful_life_extension)" t-as="line">
                                        <tr>
                                            <td><span t-esc="line.asset_id.name"/></td>
                                            <td class="text-right"><span t-esc="line.useful_life_before"/></td>
                                            <td class="text-right"><strong t-esc="line.useful_life_extension"/></td>
                                            <td class="text-right"><span t-esc="line.useful_life_after"/></td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </t>

                        <!-- Conclusion -->
                        <div style="margin: 15px 0;">
                            <p>
                                Роботи виконані повністю, у відповідності до договору-підстави,
                                якість прийнятого обладнання задовольняє вимогам експлуатації.
                                Об'єкти модернізації введено в експлуатацію з
                                <span t-field="o.date" t-options='{"widget": "date"}'/>.
                            </p>
                        </div>

                        <!-- Signatures -->
                        <div style="margin-top: 30px;">
                            <table class="no-border-all" style="width: 100%;">
                                <tr>
                                    <td style="width: 35%;">Голова комісії</td>
                                    <td style="width: 30%; border-bottom: 1px solid black;"></td>
                                    <td style="width: 5%;"></td>
                                    <td style="width: 30%; border-bottom: 1px solid black;"></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                                <tr><td colspan="4" style="height: 15px;"></td></tr>
                                <tr>
                                    <td>Члени комісії</td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                                <tr><td colspan="4" style="height: 15px;"></td></tr>
                                <tr>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                                <tr><td colspan="4" style="height: 15px;"></td></tr>
                                <tr>
                                    <td>Прийняв (МВО)</td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
