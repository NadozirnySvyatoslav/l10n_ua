<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MNMA Commissioning Act Report Action -->
    <record id="action_report_mnma_commission" model="ir.actions.report">
        <field name="name">Акт введення МНМА</field>
        <field name="model">l10n_ua.mnma</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_assets.report_mnma_commission_document</field>
        <field name="print_report_name">'Акт_МНМА_%s' % (object.commission_act_number or object.name)</field>
        <field name="binding_model_id" ref="model_l10n_ua_mnma"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="l10n_ua_doc_reports.paperformat_ua_report"/>
    </record>

    <!-- MNMA Commissioning Act Template -->
    <template id="report_mnma_commission_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <t t-set="company" t-value="o.company_id"/>
                        <t t-set="comp_partner" t-value="company.partner_id"/>

                        <!-- Company header -->
                        <div class="company-header">
                            <div class="company-name" t-field="company.name"/>
                            <t t-if="comp_partner.edrpou">
                                <div class="company-code">
                                    ЄДРПОУ: <span t-field="comp_partner.edrpou"/>
                                </div>
                            </t>
                        </div>

                        <!-- Title -->
                        <div class="ua-report-title" style="margin: 20px 0 5px 0;">
                            АКТ<br/>
                            <span style="font-size: 12pt;">введення МНМА в експлуатацію</span>
                        </div>

                        <div class="text-center" style="margin-bottom: 15px; font-size: 11pt;">
                            № <strong t-out="o.commission_act_number or '___'"/>
                            від
                            <t t-if="o.commission_date">
                                <span t-field="o.commission_date" t-options='{"widget": "date"}'/>
                            </t>
                            <t t-else="">«___» ___________ 20__ р.</t>
                        </div>

                        <!-- Details table -->
                        <table class="mb-3" style="width: 100%;">
                            <tr>
                                <th style="width: 5%;">№</th>
                                <th style="width: 30%;">Найменування</th>
                                <th style="width: 15%;">Інвентарний №</th>
                                <th style="width: 15%;">Вартість, грн</th>
                                <th style="width: 15%;">Метод списання</th>
                                <th style="width: 20%;">Знос при введенні, грн</th>
                            </tr>
                            <tr>
                                <td class="text-center">1</td>
                                <td><strong t-field="o.name"/></td>
                                <td class="text-center" t-out="o.inventory_number or '—'"/>
                                <td class="text-right"><span t-out="'%.2f' % o.original_value"/></td>
                                <td class="text-center">
                                    <t t-if="o.write_off_method == '50_50'">50/50</t>
                                    <t t-else="">100%</t>
                                </td>
                                <td class="text-right">
                                    <t t-if="o.write_off_method == '100'">
                                        <span t-out="'%.2f' % o.original_value"/>
                                    </t>
                                    <t t-else="">
                                        <span t-out="'%.2f' % (o.original_value / 2)"/>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- Location and responsible -->
                        <table class="no-border-all mb-3" style="width: 100%;">
                            <tr>
                                <td style="width: 30%;">Підрозділ:</td>
                                <td><span t-out="o.department_id.name if o.department_id else '________________________'"/></td>
                            </tr>
                            <tr>
                                <td>Місцезнаходження:</td>
                                <td><span t-out="o.location or '________________________'"/></td>
                            </tr>
                            <tr>
                                <td>Відповідальна особа:</td>
                                <td><span t-out="o.responsible_id.name if o.responsible_id else '________________________'"/></td>
                            </tr>
                        </table>

                        <!-- Signatures -->
                        <div style="margin-top: 30px;">
                            <table class="no-border-all" style="width: 100%;">
                                <tr>
                                    <td style="width: 30%;">Здав</td>
                                    <td style="width: 30%; border-bottom: 1px solid black;"></td>
                                    <td style="width: 10%;"></td>
                                    <td style="width: 30%; border-bottom: 1px solid black;"></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                                <tr><td colspan="4" style="height: 15px;"></td></tr>
                                <tr>
                                    <td>Прийняв (МВО)</td>
                                    <td style="border-bottom: 1px solid black;"></td>
                                    <td></td>
                                    <td style="border-bottom: 1px solid black;">
                                        <span t-out="o.responsible_id.name if o.responsible_id else ''"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-center small">(підпис)</td>
                                    <td></td>
                                    <td class="text-center small">(ПІБ)</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
