<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Sequence: Asset Commissioning Act -->
    <record id="seq_asset_commission_act" model="ir.sequence">
        <field name="name">Акт введення ОЗ в експлуатацію</field>
        <field name="code">l10n_ua.asset.commission.act</field>
        <field name="prefix">АВ-</field>
        <field name="padding">4</field>
    </record>

    <!-- Sequence: Asset Write-off Act -->
    <record id="seq_asset_writeoff_act" model="ir.sequence">
        <field name="name">Акт списання ОЗ</field>
        <field name="code">l10n_ua.asset.writeoff.act</field>
        <field name="prefix">АС-</field>
        <field name="padding">4</field>
    </record>

    <!-- Sequence: MNMA Commissioning Act -->
    <record id="seq_mnma_commission_act" model="ir.sequence">
        <field name="name">Акт введення МНМА в експлуатацію</field>
        <field name="code">l10n_ua.mnma.commission.act</field>
        <field name="prefix">МВ-</field>
        <field name="padding">4</field>
    </record>

    <!-- Sequence: MNMA Write-off Act -->
    <record id="seq_mnma_writeoff_act" model="ir.sequence">
        <field name="name">Акт списання МНМА</field>
        <field name="code">l10n_ua.mnma.writeoff.act</field>
        <field name="prefix">МС-</field>
        <field name="padding">4</field>
    </record>

    <!-- Sequence: Asset Revaluation -->
    <record id="seq_asset_revaluation" model="ir.sequence">
        <field name="name">Переоцінка ОЗ</field>
        <field name="code">l10n_ua.asset.revaluation</field>
        <field name="prefix">ПО-</field>
        <field name="padding">4</field>
    </record>

    <!-- Sequence: Asset Modernization -->
    <record id="seq_asset_modernization" model="ir.sequence">
        <field name="name">Модернізація ОЗ</field>
        <field name="code">l10n_ua.asset.modernization</field>
        <field name="prefix">МД-</field>
        <field name="padding">4</field>
    </record>

</odoo>
