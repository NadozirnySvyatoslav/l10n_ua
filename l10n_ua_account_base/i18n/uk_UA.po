#. module: l10n_ua_account_base
#: model_terms:ir.actions.act_window,help:l10n_ua_account_base.l10n_ua_offbalance_move_action
msgid "Запис позабалансового обліку"
msgstr "Запис позабалансового обліку"

#. module: l10n_ua_account_base
#. odoo-python
#: code:addons/l10n_ua_account_base/models/l10n_ua_offbalance.py:0
msgid "Запис позабалансового обліку не має рядків."
msgstr "Запис позабалансового обліку не має рядків."

#. module: l10n_ua_account_base
#: model_terms:ir.actions.act_window,help:l10n_ua_account_base.l10n_ua_offbalance_move_action
msgid ""
"Клас 0 ведеться за простою системою (Інструкція, наказ Мінфіну № 291):\n"
"               лише дебет (надходження) або лише кредит (вибуття), без\n"
"               кореспондуючого рахунку. На баланс, ОСВ і Форму № 1 записи не впливають."
msgstr ""
"Клас 0 ведеться за простою системою (Інструкція, наказ Мінфіну № 291):\n"
"               лише дебет (надходження) або лише кредит (вибуття), без\n"
"               кореспондуючого рахунку. На баланс, ОСВ і Форму № 1 записи не впливають."

#. module: l10n_ua_account_base
#. odoo-python
#: code:addons/l10n_ua_account_base/models/l10n_ua_offbalance.py:0
msgid "ОСВ клас 0 (%(start)s – %(end)s)"
msgstr "ОСВ клас 0 (%(start)s – %(end)s)"

#. module: l10n_ua_account_base
#: model:ir.model.fields,help:l10n_ua_account_base.field_l10n_ua_offbalance_osv__account_id
