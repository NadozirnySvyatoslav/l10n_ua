#. module: l10n_ua_account_base
#: model:ir.model.fields,help:l10n_ua_account_base.field_l10n_ua_offbalance_move__ref
msgid ""
"Документ-підстава: договір оренди, акт приймання на зберігання, накладна на "
"бланки тощо."
msgstr ""
"Документ-підстава: договір оренди, акт приймання на зберігання, накладна на "
