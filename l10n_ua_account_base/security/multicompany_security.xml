<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             UA accounting documents must be scoped to the user's allowed
             companies — without these rules the records were visible across
             ALL companies, including non-UA ones. Standard Odoo pattern
             (see l10n_ua_account_vat security). -->

        <record id="l10n_ua_journal_order_company_rule" model="ir.access">
            <field name="name">Журнал-ордер: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_journal_order"/>
            <field name="domain">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="operation">crud</field>
        </record>

        <record id="l10n_ua_account_card_company_rule" model="ir.access">
            <field name="name">Картка рахунку: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_account_card"/>
