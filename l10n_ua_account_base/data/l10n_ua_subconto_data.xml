<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        Standard Subconto Types (like 1C:Accounting)

        These are analytical dimensions that can be attached to accounts.
        Only types for base modules are created here.
        Additional types for hr, stock, etc. should be created when those modules are installed.
        -->

        <record id="subconto_type_partner" model="l10n_ua.subconto.type">
            <field name="name">Partners</field>
            <field name="code">PARTNER</field>
            <field name="sequence">10</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="field_name">name</field>
            <field name="description">Counterparties, customers, suppliers (Контрагенти)</field>
        </record>

        <record id="subconto_type_bank" model="l10n_ua.subconto.type">
            <field name="name">Bank Accounts</field>
            <field name="code">BANK</field>
            <field name="sequence">20</field>
            <field name="model_id" ref="base.model_res_partner_bank"/>
            <field name="field_name">account_number</field>
            <field name="description">Bank accounts (Банківські рахунки)</field>
        </record>

        <record id="subconto_type_account" model="l10n_ua.subconto.type">
            <field name="name">Accounts</field>
            <field name="code">ACCOUNT</field>
            <field name="sequence">30</field>
            <field name="model_id" ref="account.model_account_account"/>
            <field name="field_name">display_name</field>
            <field name="description">GL Accounts for cross-references (Рахунки)</field>
        </record>

        <record id="subconto_type_journal" model="l10n_ua.subconto.type">
            <field name="name">Journals</field>
            <field name="code">JOURNAL</field>
            <field name="sequence">40</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="field_name">name</field>
            <field name="description">Accounting journals (Журнали)</field>
        </record>

        <!--
        Additional subconto types to create manually when modules are installed:

        - Products (PRODUCT): product.model_product_product - Номенклатура
        - Warehouses (WAREHOUSE): stock.model_stock_warehouse - Склади
        - Departments (DEPARTMENT): hr.model_hr_department - Підрозділи
        - Employees (EMPLOYEE): hr.model_hr_employee - Працівники
        - Analytic Accounts (ANALYTIC): analytic.model_account_analytic_account - Статті витрат
        - Fixed Assets (ASSET): account_asset.model_account_asset - Основні засоби
        -->

    </data>
</odoo>
