#. module: l10n_ua_hr_documents_certificates
#: model:hr.certificate.type,template_body:l10n_ua_hr_documents_certificates.certificate_type_character
msgid ""
"\n"
"<div style=\"font-family: Times New Roman, serif; font-size: 14pt; line-height: 1.5;\">\n"
"    <div style=\"text-align: center; margin: 30px 0;\">\n"
"        <h2 style=\"margin: 0;\">ХАРАКТЕРИСТИКА</h2>\n"
"        <p style=\"margin: 5px 0;\">№ {certificate_number}</p>\n"
"    </div>\n"
"\n"
"    <p style=\"text-indent: 40px; text-align: justify;\">\n"
"        <strong>{employee_name}</strong> працює в {company_name}\n"
"        на посаді <strong>{employee_position}</strong> з {employee_hire_date}.\n"
"    </p>\n"
"\n"
"    <p style=\"text-indent: 40px; text-align: justify;\">\n"
"        За час роботи зарекомендував(ла) себе як відповідальний,\n"
"        дисциплінований працівник, який сумлінно виконує свої посадові обов'язки.\n"
"    </p>\n"
"\n"
"    <p style=\"text-indent: 40px; text-align: justify;\">\n"
"        Має високий рівень професійної підготовки, постійно підвищує свою кваліфікацію.\n"
"        До виконання доручень ставиться відповідально.\n"
"    </p>\n"
"\n"
"    <p style=\"text-indent: 40px; text-align: justify;\">\n"
"        У колективі користується повагою. Комунікабельний(на),\n"
"        вміє працювати в команді.\n"
"    </p>\n"
"\n"
"    <p style=\"text-indent: 40px; text-align: justify;\">\n"
"        Характеристика видана {destination}.\n"
"    </p>\n"
"\n"
"    <div style=\"margin-top: 50px;\">\n"
"        <table style=\"width: 100%; border: none;\">\n"
"            <tr>\n"
"                <td style=\"width: 50%;\">{company_director_position}</td>\n"
"                <td style=\"width: 50%; text-align: right;\">________________ {company_director}</td>\n"
"            </tr>\n"
"        </table>\n"
"    </div>\n"
"\n"
"    <p style=\"margin-top: 20px;\">{certificate_date}</p>\n"
"    <p style=\"font-size: 12pt;\">М.П.</p>\n"
"</div>\n"
"            "
msgstr ""

