#. module: l10n_ua_hr_documents_certificates
#: model:hr.certificate.type,template_body:l10n_ua_hr_documents_certificates.certificate_type_income
msgid ""
"\n"
"<div style=\"font-family: Times New Roman, serif; font-size: 14pt; line-height: 1.5;\">\n"
"    <div style=\"text-align: center; margin-bottom: 20px;\">\n"
"        <strong>{company_name}</strong><br/>\n"
"        <span style=\"font-size: 12pt;\">{company_address}</span><br/>\n"
"        <span style=\"font-size: 12pt;\">ЄДРПОУ: {company_edrpou}</span>\n"
"    </div>\n"
"\n"
"    <div style=\"text-align: center; margin: 30px 0;\">\n"
"        <h2 style=\"margin: 0;\">ДОВІДКА</h2>\n"
"        <p style=\"margin: 5px 0;\">про доходи</p>\n"
"        <p style=\"margin: 5px 0;\">№ {certificate_number} від {certificate_date}</p>\n"
"    </div>\n"
"\n"
"    <p style=\"text-indent: 40px; text-align: justify;\">\n"
"        Видана <strong>{employee_name}</strong>, РНОКПП: {employee_rnokpp},\n"
"        у тому, що він(вона) працює в {company_name} на посаді <strong>{employee_position}</strong>.\n"
"    </p>\n"
"\n"
"    <p style=\"text-indent: 40px; text-align: justify;\">\n"
"        За період з {period_from} по {period_to} отримав(ла) дохід у розмірі\n"
"        <strong>{total_income} грн.</strong>\n"
"    </p>\n"
"\n"
"    <p style=\"text-indent: 40px; text-align: justify;\">\n"
"        Довідка видана {destination}.\n"
"    </p>\n"
"\n"
"    <div style=\"margin-top: 50px;\">\n"
"        <table style=\"width: 100%; border: none;\">\n"
"            <tr>\n"
"                <td style=\"width: 50%;\">{company_director_position}</td>\n"
"                <td style=\"width: 50%; text-align: right;\">________________ {company_director}</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"width: 50%;\">Головний бухгалтер</td>\n"
"                <td style=\"width: 50%; text-align: right;\">________________</td>\n"
"            </tr>\n"
"        </table>\n"
"    </div>\n"
"\n"
"    <p style=\"margin-top: 30px; font-size: 12pt;\">М.П.</p>\n"
"</div>\n"
"            "
msgstr ""

