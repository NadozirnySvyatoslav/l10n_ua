<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_certificate_view_form" model="ir.ui.view">
            <field name="name">hr.certificate.form</field>
            <field name="model">hr.certificate</field>
            <field name="arch" type="xml">
                <form string="Certificate">
                    <header>
                        <button name="action_approve" string="Approve" type="object"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_issue" string="Issue" type="object"
                                class="btn-primary" invisible="state != 'approved'"/>
                        <button name="action_load_template" string="Reload Template" type="object"
                                invisible="state == 'issued'"/>
                        <button name="action_print" string="Print" type="object"
                                class="btn-secondary" invisible="state != 'issued'"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="state in ('issued', 'cancelled')"/>
                        <button name="action_draft" string="Set to Draft" type="object"
                                invisible="state not in ('approved', 'cancelled')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved,issued"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="certificate_type_id"/>
                                <field name="employee_id"/>
                                <field name="is_vacation_remaining" invisible="1"/>
                                <field name="vacation_as_of"
                                       invisible="not is_vacation_remaining"
                                       required="is_vacation_remaining"/>
                                <field name="destination" invisible="not requires_destination"/>
                            </group>
                            <group>
                                <field name="request_date"/>
                                <field name="issue_date" readonly="1"/>
                                <field name="valid_until" readonly="1"/>
                                <field name="issued_by" readonly="1"/>
                            </group>
                        </group>
                        <group invisible="not requires_period">
                            <group>
                                <field name="period_from"/>
                                <field name="period_to"/>
                            </group>
                        </group>
                        <group invisible="not requires_salary_info">
                            <group>
                                <field name="salary_amount"/>
                                <field name="total_income" invisible="not requires_period"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <!-- Hidden related fields -->
                        <field name="requires_salary_info" invisible="1"/>
                        <field name="requires_period" invisible="1"/>
                        <field name="requires_destination" invisible="1"/>
                        <notebook>
                            <page string="Certificate Content" name="content">
                                <field name="body" widget="html"/>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" placeholder="Internal notes..."/>
                                <group>
                                    <field name="copies_count"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="hr_certificate_view_tree" model="ir.ui.view">
            <field name="name">hr.certificate.tree</field>
            <field name="model">hr.certificate</field>
            <field name="arch" type="xml">
                <list string="Certificates" decoration-muted="state == 'cancelled'"
                      decoration-info="state == 'draft'" decoration-success="state == 'issued'">
                    <field name="name"/>
                    <field name="certificate_type_id"/>
                    <field name="employee_id"/>
                    <field name="request_date"/>
                    <field name="issue_date"/>
                    <field name="valid_until"/>
                    <field name="destination"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'approved'"
                           decoration-success="state == 'issued'"
                           decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <record id="hr_certificate_view_search" model="ir.ui.view">
            <field name="name">hr.certificate.search</field>
            <field name="model">hr.certificate</field>
            <field name="arch" type="xml">
                <search string="Certificates">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="certificate_type_id"/>
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                    <filter name="filter_issued" string="Issued" domain="[('state', '=', 'issued')]"/>
                </search>
            </field>
        </record>

        <record id="action_hr_certificate" model="ir.actions.act_window">
            <field name="name">Certificates</field>
            <field name="res_model">hr.certificate</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="hr_certificate_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Issue a new certificate
                </p>
                <p>
                    Create certificates for employees: employment certificates,
                    salary certificates, income references, and more.
                </p>
            </field>
        </record>

    </data>
</odoo>
