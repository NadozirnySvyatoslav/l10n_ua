<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="action_report_hr_certificate" model="ir.actions.report">
        <field name="name">Certificate</field>
        <field name="model">hr.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_hr_documents_certificates.report_hr_certificate</field>
        <field name="report_file">l10n_ua_hr_documents_certificates.report_hr_certificate</field>
        <field name="binding_model_id" ref="model_hr_certificate"/>
        <field name="binding_type">report</field>
        <!-- The page format of the orders: no room kept for a company header. -->
        <field name="paperformat_id" ref="l10n_ua_hr_base.paperformat_a4_ua"/>
    </record>

    <!-- Every certificate body carries its own header (company, code,
         document title), so the company's document layout would print a
         second one: the plain layout keeps a single header. -->
    <template id="report_hr_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-raw="doc.body"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Simple certificate template without external layout -->
    <template id="report_hr_certificate_simple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="padding: 40px;">
                    <t t-raw="doc.body"/>
                </div>
            </t>
        </t>
    </template>

    </data>
</odoo>
