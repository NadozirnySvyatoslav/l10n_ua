<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default certificate sequence (fallback) -->
        <record id="seq_hr_certificate_default" model="ir.sequence">
            <field name="name">HR Certificate: Default</field>
            <field name="code">hr.certificate</field>
            <field name="prefix">Д-%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences for specific certificate types -->
        <record id="seq_hr_certificate_employment" model="ir.sequence">
            <field name="name">HR Certificate: Employment</field>
