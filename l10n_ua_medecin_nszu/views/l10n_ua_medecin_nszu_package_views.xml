<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_package_list" model="ir.ui.view">
        <field name="name">l10n_ua.medecin.nszu.package.list</field>
        <field name="model">l10n_ua.medecin.nszu.package</field>
        <field name="arch" type="xml">
            <list string="Пакети НСЗУ" decoration-warning="tariff_to_confirm">
                <header>
                    <button name="action_open_copy_wizard" type="object"
                            string="Копіювати на інший рік" display="always"
                            groups="l10n_ua_medecin_base.group_ua_medecin_manager"/>
                </header>
                <field name="code"/>
                <field name="name"/>
                <field name="package_type"/>
                <field name="payment_model"/>
                <field name="year"/>
                <field name="base_tariff" widget="monetary"/>
                <field name="tariff_to_confirm" optional="show"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_package_form" model="ir.ui.view">
        <field name="name">l10n_ua.medecin.nszu.package.form</field>
        <field name="model">l10n_ua.medecin.nszu.package</field>
        <field name="arch" type="xml">
            <form string="Пакет НСЗУ">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not tariff_to_confirm">
                        Тариф не підтверджено: звірте його з чинною постановою КМУ про
                        Програму медичних гарантій / наказом НСЗУ, вкажіть актуальне значення
                        і зніміть позначку «Тариф потребує підтвердження».
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="package_type"/>
                            <field name="payment_model"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="base_tariff"/>
                            <field name="tariff_to_confirm"/>
                            <field name="currency_id"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group string="Специфікація">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_package_search" model="ir.ui.view">
        <field name="name">l10n_ua.medecin.nszu.package.search</field>
        <field name="model">l10n_ua.medecin.nszu.package</field>
        <field name="arch" type="xml">
            <search string="Пакети НСЗУ">
                <field name="code"/>
                <field name="name"/>
                <field name="year"/>
                <filter name="filter_active" string="Активні" domain="[('is_active', '=', True)]"/>
                <filter name="filter_to_confirm" string="Тариф потребує підтвердження"
                        domain="[('tariff_to_confirm', '=', True)]"/>
                <separator/>
                <filter name="group_year" string="Рік" context="{'group_by': 'year'}"/>
                <filter name="group_type" string="Тип" context="{'group_by': 'package_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_package" model="ir.actions.act_window">
        <field name="name">Пакети НСЗУ</field>
        <field name="res_model">l10n_ua.medecin.nszu.package</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_year': 1}</field>
    </record>
</odoo>
