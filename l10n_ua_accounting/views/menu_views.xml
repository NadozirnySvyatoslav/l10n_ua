<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================================
         Українські пункти вкладено в рідний застосунок обліку
         (`account.menu_finance`, перейменований на «Бухоблік»).

         Власного кореня «Accounting» більше немає: він стояв поруч із рідним
         апом Odoo, повторював його Invoices / Vendor Bills / План рахунків /
         Журнали і давав два шляхи до одних даних (антипатерн H2,
         docs/menu_architecture.md). Кожен UA-пункт тепер живе в тій секції
         ядра, до якої належить за змістом.

         Гейтинг: раніше достатньо було закрити корінь — усе піддерево
         ховалося разом із ним. Тепер батьки належать ядру, тому кожна UA-гілка
         несе `groups="l10n_ua_account_base.group_ua_accountant"` явно.
         ==================================================================== -->

    <!-- ==================== Клієнти ==================== -->
    <menuitem id="menu_ua_docs_service_acts"
              name="Service Acts"
              parent="account.menu_finance_receivables"
              action="action_service_act"
              groups="l10n_ua_account_base.group_ua_accountant"
              sequence="25"/>

    <!-- ==================== Постачальники ==================== -->
    <menuitem id="menu_ua_docs_advance_reports"
              name="Advance Reports"
              parent="account.menu_finance_payables"
              action="action_advance_report"
              groups="l10n_ua_account_base.group_ua_accountant"
              sequence="25"/>

    <!-- ==================== Бухгалтерія → Каса та банк ==================== -->
    <menuitem id="menu_ua_cash_bank"
              name="Cash and Bank"
              parent="account.menu_finance_entries"
              groups="l10n_ua_account_base.group_ua_accountant"
              sequence="10"/>

    <menuitem id="menu_ua_cash_pko"
              name="Income Cash Orders (PKO)"
              parent="menu_ua_cash_bank"
              action="action_account_payment_pko"
              sequence="10"/>

    <menuitem id="menu_ua_cash_vko"
              name="Expense Cash Orders (VKO)"
              parent="menu_ua_cash_bank"
              action="action_account_payment_vko"
              sequence="20"/>

    <menuitem id="menu_ua_payment_orders"
              name="Payment Orders"
              parent="menu_ua_cash_bank"
              action="action_account_payment_pd"
              sequence="25"/>

    <menuitem id="menu_ua_cash_book"
              name="Cash Book"
              parent="menu_ua_cash_bank"
              action="action_cash_book_wizard"
              sequence="30"/>

    <menuitem id="menu_ua_reconciliation"
              name="Reconciliation Acts"
              parent="menu_ua_cash_bank"
              action="action_reconciliation_act_wizard"
              sequence="40"/>

    <menuitem id="menu_ua_currency_exchange"
              name="Currency Purchase / Sale"
              parent="menu_ua_cash_bank"
              action="l10n_ua_currency_exchange_action"
              sequence="60"/>

    <!-- ==================== Бухгалтерія → Закриття ==================== -->
    <!-- `account.account_closing_menu` — рідна секція закриття періоду.
         Процедури закриття UA стають поруч із нею, а не окремою гілкою. -->
    <menuitem id="menu_ua_period_closing"
              name="Period Closing"
              parent="account.account_closing_menu"
              action="l10n_ua_period_closing_action"
              groups="l10n_ua_account_base.group_ua_accountant"
              sequence="10"/>

    <menuitem id="menu_ua_currency_revaluation"
              name="Currency Revaluation"
              parent="account.account_closing_menu"
              action="l10n_ua_currency_revaluation_action"
              groups="l10n_ua_account_base.group_ua_accountant"
              sequence="20"/>

    <menuitem id="menu_ua_stock_inventory_act"
              name="Inventory Act"
              parent="account.account_closing_menu"
              action="action_inventory_act_wizard"
              groups="l10n_ua_account_base.group_ua_accountant"
              sequence="30"/>

    <!-- ==================== Звітність → Бухгалтерські звіти ==================== -->
    <!-- Не «Фінансова звітність»: у секції поруч із формами Ф№1-Ф№3 лежать
         облікові регістри (ОСВ, журнали-ордери, головна книга), які до
         фінзвітності не належать. -->
    <menuitem id="menu_ua_reports"
              name="Accounting Reports"
              parent="account.menu_finance_reports"
              groups="l10n_ua_account_base.group_ua_accountant"
              sequence="2"/>

    <menuitem id="menu_ua_reports_osv"
              name="Trial Balance"
              parent="menu_ua_reports"
              action="l10n_ua_account_base.l10n_ua_osv_action"
              sequence="10"/>

    <menuitem id="menu_ua_reports_journal_orders"
              name="Journal Orders"
              parent="menu_ua_reports"
              action="l10n_ua_account_base.l10n_ua_journal_order_action"
              sequence="20"/>

    <!-- General Ledger — власний звіт Головної книги (#137) -->
    <menuitem id="menu_ua_reports_general_ledger"
              name="General Ledger"
              parent="menu_ua_reports"
              action="l10n_ua_account_base.l10n_ua_general_ledger_action"
              sequence="25"/>

    <!-- AR/AP Aging -->
    <menuitem id="menu_ua_reports_aging"
              name="Aging Reports"
              parent="menu_ua_reports"
              action="l10n_ua_aging_report_action"
              sequence="27"/>

    <!-- Три форми фінансової звітності за НП(С)БО 1 друкуються поспіль і в
         тому ж порядку, що й у наказі Мінфіну № 73: Ф№1, Ф№2, Ф№3. -->
    <menuitem id="menu_ua_reports_balance"
              name="Balance Sheet (Form No.1)"
              parent="menu_ua_reports"
              action="action_balance_report"
              sequence="30"/>

    <menuitem id="menu_ua_reports_pnl"
              name="Income and Expenses (P&amp;L)"
              parent="menu_ua_reports"
              action="action_pnl_report"
              sequence="40"/>

    <menuitem id="menu_ua_reports_cashflow"
              name="Cash Flow Statement"
              parent="menu_ua_reports"
              action="action_cashflow_report"
              sequence="50"/>

    <!-- ==================== Налаштування ==================== -->
    <!-- Тут навмисно порожньо. План рахунків і Журнали дає ядро
         (Configuration → Accounting), а українські довідники — парасолька
         «Ukraine» з l10n_ua_account_base, яка висить під тим самим
         Configuration і, крім КОАТУУ, тримає ще КВЕД і типи субконто.
         Власний пункт «Довідники» був би другим шляхом до тих самих даних
         (антипатерн H1, #190). -->

    <!-- ПДВ (l10n_ua_account_vat) та Основні засоби (l10n_ua_assets) навмисно
         НЕ оголошуються тут: їхні actions уже мають єдиний дім у модулях-фічах
         (антипатерн H1, #190). Дублювати їх = два шляхи до одних даних. -->

</odoo>
