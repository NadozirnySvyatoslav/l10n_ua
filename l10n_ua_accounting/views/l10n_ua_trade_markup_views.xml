<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Списання торгової націнки (#148) ==================== -->

    <record id="l10n_ua_trade_markup_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.trade.markup.form</field>
        <field name="model">l10n_ua.trade.markup</field>
        <field name="arch" type="xml">
            <form string="Trade Markup Write-off">
                <header>
                    <button name="action_compute" string="Compute" type="object"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_post" string="Post" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'posted'"
                            confirm="Cancel this write-off? Its journal entry will be reversed."/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_move" type="object" class="oe_stat_button"
                                icon="fa-book" string="Journal Entry" invisible="not move_id"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="move_id" invisible="1"/>
                            <field name="closing_id" invisible="not closing_id"/>
                        </group>
                        <group>
                            <field name="goods_account_id" readonly="state != 'draft'"/>
                            <field name="markup_account_id" readonly="state != 'draft'"/>
                            <field name="default_account_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Average Markup (NP(S)BO 9, item 22)">
                        <group>
                            <field name="opening_retail"/>
                            <field name="received_retail"/>
                            <field name="disposed_retail"/>
                        </group>
                        <group>
                            <field name="opening_markup"/>
                            <field name="received_markup"/>
                            <field name="markup_percent"/>
                            <field name="markup_amount" class="fw-bold"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="account_id"/>
                            <field name="retail_amount" sum="Total"/>
                            <field name="markup_amount" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_trade_markup_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.trade.markup.list</field>
        <field name="model">l10n_ua.trade.markup</field>
        <field name="arch" type="xml">
            <list string="Trade Markup Write-off" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="markup_percent"/>
                <field name="disposed_retail" sum="Total"/>
                <field name="markup_amount" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_trade_markup_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.trade.markup.search</field>
        <field name="model">l10n_ua.trade.markup</field>
        <field name="arch" type="xml">
            <search string="Trade Markup Write-off">
                <field name="name"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="filter_posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <group>
                    <filter string="Status" name="groupby_state" domain="[]"
                            context="{'group_by': 'state'}"/>
                    <filter string="Period" name="groupby_date" domain="[]"
                            context="{'group_by': 'date_to:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ua_trade_markup_action" model="ir.actions.act_window">
        <field name="name">Trade Markup Write-off</field>
        <field name="res_model">l10n_ua.trade.markup</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_ua_trade_markup_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Write off the trade markup of a month</p>
            <p>Retail at sale prices (accounts 282 and 285): the markup on goods
               sold or otherwise disposed of is written off at the average markup
               percent of the month (NP(S)BO 9, item 22). The period closing does
               this automatically.</p>
        </field>
    </record>

</odoo>
