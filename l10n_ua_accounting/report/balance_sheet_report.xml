<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Balance Sheet Report Action -->
    <record id="action_report_balance_sheet" model="ir.actions.report">
        <field name="name">Balance Sheet (Form No.1)</field>
        <field name="model">l10n_ua.balance.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_accounting.report_balance_sheet_document</field>
        <field name="print_report_name">'Баланс_%s' % object.date_to</field>
        <field name="paperformat_id" ref="l10n_ua_doc_reports.paperformat_ua_report"/>
    </record>

    <!-- Balance Sheet Report Template -->
    <template id="report_balance_sheet_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <!-- Header -->
                        <div class="text-center mb-2">
                            <div class="small">Додаток 1 до Національного положення (стандарту)</div>
                            <div class="small">бухгалтерського обліку 1 «Загальні вимоги до фінансової звітності»</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-8">
                                <table class="table-borderless" style="width: 100%;">
                                    <tr>
                                        <td style="width: 120px;">Підприємство</td>
                                        <td class="border-bottom"><span t-field="report.company_id.name"/></td>
                                    </tr>
                                    <tr t-if="report.company_id.company_registry">
                                        <td>за ЄДРПОУ</td>
                                        <td class="border-bottom"><span t-field="report.company_id.company_registry"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-4 text-right">
                                <div class="small">КОДИ</div>
                                <table class="small" style="float: right;">
                                    <tr>
                                        <td class="border">Дата (рік, місяць, число)</td>
                                        <td class="border text-center" t-esc="report.date_to.strftime('%Y.%m.%d')"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="ua-report-title">
                            БАЛАНС<br/>
                            (Звіт про фінансовий стан)
                        </div>
                        <div class="ua-report-subtitle mb-3">
                            на <span t-field="report.date_to" t-options='{"widget": "date"}'/> р.
                        </div>

                        <div class="small text-center mb-2">Форма № 1</div>

                        <!-- Report table from stored lines -->
                        <table>
                            <thead>
                                <tr>
                                    <th style="width: 50%;">Стаття</th>
                                    <th style="width: 10%;">Код рядка</th>
                                    <th style="width: 20%;">На початок звітного періоду</th>
                                    <th style="width: 20%;">На кінець звітного періоду</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="report.line_ids.sorted('sequence')" t-as="line">
                                    <!-- Section header -->
                                    <tr t-if="line.line_type == 'section'">
                                        <td class="bold" t-esc="line.name"/>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <!-- Detail line -->
                                    <tr t-if="line.line_type == 'detail'">
                                        <td t-esc="line.name"/>
                                        <td class="text-center" t-esc="line.code"/>
                                        <td class="text-right" t-esc="'%.0f' % line.previous_amount"/>
                                        <td class="text-right" t-esc="'%.0f' % line.current_amount"/>
                                    </tr>
                                    <!-- Subtotal -->
                                    <tr t-if="line.line_type == 'subtotal'">
                                        <td class="bold" t-esc="line.name"/>
                                        <td class="text-center" t-esc="line.code"/>
                                        <td class="text-right bold" t-esc="'%.0f' % line.previous_amount"/>
                                        <td class="text-right bold" t-esc="'%.0f' % line.current_amount"/>
                                    </tr>
                                    <!-- Total -->
                                    <tr t-if="line.line_type == 'total'" style="border-top: 2px solid black;">
                                        <td class="bold" t-esc="line.name"/>
                                        <td class="text-center" t-esc="line.code"/>
                                        <td class="text-right bold" t-esc="'%.0f' % line.previous_amount"/>
                                        <td class="text-right bold" t-esc="'%.0f' % line.current_amount"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Signatures -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <div class="signature-row">
                                    <span>Керівник</span>
                                    <span class="signature-line"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="signature-row">
                                    <span>Головний бухгалтер</span>
                                    <span class="signature-line"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
