<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PKO Report Template (Прибутковий касовий ордер, форма КО-1) -->
    <template id="report_pko_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <div class="row">
                            <!-- Left side: PKO -->
                            <div class="col-8" style="padding-right: 20px;">
                                <!-- Header -->
                                <div class="form-number-box">
                                    <div class="small">Типова форма № КО-1</div>
                                    <div class="small">Затверджено наказом</div>
                                    <div class="small">Мінстату України</div>
                                    <div class="small">від 15.02.96 № 51</div>
                                </div>

                                <div class="company-header">
                                    <div class="company-name" t-field="o.company_id.name"/>
                                    <div class="small">(найменування підприємства (організації))</div>
                                    <div class="company-code">
                                        Ідентифікаційний код ЄДРПОУ:
                                        <span t-field="o.company_id.edrpou"/>
                                    </div>
                                </div>

                                <div class="ua-report-title">
                                    ПРИБУТКОВИЙ КАСОВИЙ ОРДЕР
                                </div>

                                <table class="mb-3" style="width: auto;">
                                    <tr>
                                        <td class="text-center" style="width: 80px;">Номер<br/>документа</td>
                                        <td class="text-center" style="width: 100px;">Дата<br/>складання</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center bold"><span t-field="o.ua_cash_order_number"/></td>
                                        <td class="text-center"><span t-field="o.date" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                </table>

                                <!-- Main table -->
                                <table class="mb-3">
                                    <tr>
                                        <th colspan="2">Кореспондуючий рахунок, субрахунок</th>
                                        <th rowspan="2" style="width: 80px;">Код аналітичного обліку</th>
                                        <th rowspan="2" style="width: 100px;">Сума, грн</th>
                                        <th rowspan="2" style="width: 60px;">Код цільового призначення</th>
                                    </tr>
                                    <tr>
                                        <th style="width: 60px;">рахунок</th>
                                        <th style="width: 60px;">субрахунок</th>
                                    </tr>
                                    <tr>
                                        <td class="text-center">
                                            <t t-if="o.destination_account_id">
                                                <span t-field="o.destination_account_id.code"/>
                                            </t>
                                        </td>
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                        <td class="text-right money">
                                            <span t-field="o.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-center">-</td>
                                    </tr>
                                </table>

                                <div class="mb-2">
                                    <span class="bold">Прийнято від: </span>
                                    <span t-if="o.partner_id" t-field="o.partner_id.name"/>
                                    <span t-elif="o.ua_cash_person" t-field="o.ua_cash_person"/>
                                    <span t-else="">_______________________</span>
                                </div>

                                <div class="mb-2">
                                    <span class="bold">Підстава: </span>
                                    <span t-if="o.ua_payment_basis" t-field="o.ua_payment_basis"/>
                                    <span t-elif="o.memo" t-field="o.memo"/>
                                    <span t-else="">_______________________</span>
                                </div>

                                <div class="mb-2">
                                    <span class="bold">Сума: </span>
                                    <span class="amount-words">
                                        <!-- Amount in words would be computed -->
                                        <t t-esc="o.amount"/> грн.
                                    </span>
                                </div>

                                <div class="mb-2">
                                    <span class="bold">Додатки: </span>
                                    <span t-if="o.ua_appendix" t-field="o.ua_appendix"/>
                                    <span t-else="">_______________________</span>
                                </div>

                                <!-- Signatures -->
                                <div class="signature-block">
                                    <div class="signature-row">
                                        <span>Головний бухгалтер</span>
                                        <span class="signature-line"></span>
                                        <span class="small">(підпис)</span>
                                    </div>
                                    <div class="signature-row">
                                        <span>Одержав касир</span>
                                        <span class="signature-line"></span>
                                        <span class="small">(підпис)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Right side: Квитанція (Receipt stub) -->
                            <div class="col-4" style="border-left: 1px dashed black; padding-left: 20px;">
                                <div class="text-center small mb-2">
                                    Лінія відрізу
                                </div>

                                <div class="ua-report-title" style="font-size: 10pt;">
                                    КВИТАНЦІЯ
                                </div>

                                <div class="small mb-2">
                                    до прибуткового касового ордеру<br/>
                                    № <span class="bold" t-field="o.ua_cash_order_number"/><br/>
                                    від <span t-field="o.date" t-options='{"widget": "date"}'/>
                                </div>

                                <div class="small mb-2">
                                    Прийнято від:<br/>
                                    <span t-if="o.partner_id" t-field="o.partner_id.name"/>
                                    <span t-elif="o.ua_cash_person" t-field="o.ua_cash_person"/>
                                </div>

                                <div class="small mb-2">
                                    Підстава:<br/>
                                    <span t-if="o.ua_payment_basis" t-field="o.ua_payment_basis"/>
                                    <span t-elif="o.memo" t-field="o.memo"/>
                                </div>

                                <div class="small mb-2">
                                    <span class="bold">Сума: </span>
                                    <span t-field="o.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </div>

                                <div class="small mb-3">
                                    <span class="italic">
                                        (прописом)
                                    </span>
                                </div>

                                <div class="signature-row small">
                                    <span>Головний бухгалтер</span>
                                    <span class="signature-line" style="min-width: 50px;"></span>
                                </div>

                                <div class="signature-row small">
                                    <span>Касир</span>
                                    <span class="signature-line" style="min-width: 50px;"></span>
                                </div>

                                <div class="text-center small mt-3">
                                    М.П.
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
