        <!-- Рядки фінзвітів (#679): компанія береться зі звіту.
             Без цих правил користувач компанії Б читав суми рядків
             звітів компанії А через search/read. -->
        <record id="l10n_ua_balance_report_line_company_rule" model="ir.access">
            <field name="name">Рядок балансу: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_balance_report_line"/>
