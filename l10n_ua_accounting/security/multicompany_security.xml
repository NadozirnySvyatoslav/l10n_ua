<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             These UA accounting models have company_id but no multi-company
             ir.rule, so records leaked across ALL companies (incl. non-UA).
             Each global rule scopes records to the user's allowed companies.
             Standard Odoo pattern (see l10n_ua_account_vat pilot). -->

        <record id="l10n_ua_advance_report_company_rule" model="ir.rule">
            <field name="name">Авансовий звіт: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_advance_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="l10n_ua_period_closing_company_rule" model="ir.rule">
            <field name="name">Закриття періоду: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_period_closing"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

