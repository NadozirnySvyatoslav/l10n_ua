<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_l10n_ua_agreement" model="ir.ui.view">
        <field name="name">sale.order.form.l10n_ua_agreement</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="l10n_ua_commercial_partner_id" invisible="1"/>
                <field name="l10n_ua_agreement_id" options="{'no_create': True}"
                       readonly="state in ('cancel', 'sale') and l10n_ua_agreement_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_l10n_ua_agreement" model="ir.ui.view">
        <field name="name">sale.order.search.l10n_ua_agreement</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="l10n_ua_agreement_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_l10n_ua_agreement" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_ua_agreement</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_l10n_ua_agreements" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        groups="sales_team.group_sale_salesman"
                        invisible="l10n_ua_agreement_count == 0">
                    <field name="l10n_ua_agreement_count" widget="statinfo" string="Agreements"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
