<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_agreement" model="ir.actions.report">
        <field name="name">Agreement</field>
        <field name="model">l10n_ua.agreement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_agreement.report_agreement_document</field>
        <field name="report_file">l10n_ua_agreement.report_agreement_document</field>
        <field name="print_report_name">'%s.pdf' % (object.code or 'agreement')</field>
        <field name="binding_model_id" ref="model_l10n_ua_agreement"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_agreement_act" model="ir.actions.report">
        <field name="name">Service Act</field>
        <field name="model">l10n_ua.agreement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_agreement.report_agreement_act</field>
        <field name="report_file">l10n_ua_agreement.report_agreement_act</field>
        <field name="print_report_name">'%s-act.pdf' % (object.code or 'agreement')</field>
        <field name="binding_model_id" ref="model_l10n_ua_agreement"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
