<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_psp_application_list" model="ir.ui.view">
        <field name="name">hr.psp.application.list</field>
        <field name="model">hr.psp.application</field>
        <field name="arch" type="xml">
            <list string="Заяви про застосування ПСП" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="rnokpp"/>
                <field name="psp_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_psp_application_form" model="ir.ui.view">
        <field name="name">hr.psp.application.form</field>
        <field name="model">hr.psp.application</field>
        <field name="arch" type="xml">
            <form string="Заява про застосування ПСП">
                <header>
                    <button name="action_activate" string="Підтвердити" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Повернути в чернетку" type="object"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="rnokpp"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="psp_type" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Підстава та документи" name="notes">
                            <group>
                                <field name="note" placeholder="Зазначте підставу та перелік доданих підтвердних документів (довідка МСЕК, свідоцтва про народження дітей тощо)..."/>
                            </group>
                            <group string="Документи">
                                <field name="attachment_ids" widget="many2many_binary" string="Вкладені файли"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_psp_application_search" model="ir.ui.view">
        <field name="name">hr.psp.application.search</field>
        <field name="model">hr.psp.application</field>
        <field name="arch" type="xml">
            <search string="Пошук заяв ПСП">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="rnokpp"/>
                <separator/>
                <filter name="filter_active_state" string="Чинні" domain="[('state', '=', 'active')]"/>
                <filter name="filter_draft" string="Чернетки" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <group>
                    <filter name="group_by_employee" string="Працівник" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_state" string="Статус" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_by_psp_type" string="Розмір ПСП" domain="[]" context="{'group_by': 'psp_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_psp_application" model="ir.actions.act_window">
        <field name="name">Заяви про застосування ПСП</field>
        <field name="res_model">hr.psp.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_psp_application_search"/>
        <field name="context">{'search_default_filter_active_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Створіть першу заяву про застосування податкової соціальної пільги
            </p>
            <p>
                Заява фіксує обране працівником місце та розмір застосування ПСП відповідно до ст. 169 ПКУ.
            </p>
        </field>
    </record>

</odoo>
