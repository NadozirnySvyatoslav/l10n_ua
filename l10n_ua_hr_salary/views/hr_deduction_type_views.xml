<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_deduction_type_view_form" model="ir.ui.view">
        <field name="name">hr.deduction.type.form</field>
        <field name="model">hr.deduction.type</field>
        <field name="arch" type="xml">
            <form string="Deduction Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="calculation_method"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_rate"/>
                            <field name="default_amount"/>
                            <field name="priority"/>
                            <field name="max_percent"/>
                            <field name="is_mandatory"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_deduction_type_view_tree" model="ir.ui.view">
        <field name="name">hr.deduction.type.tree</field>
        <field name="model">hr.deduction.type</field>
        <field name="arch" type="xml">
            <list string="Deduction Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="default_rate"/>
                <field name="priority"/>
                <field name="is_mandatory"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_hr_deduction_type" model="ir.actions.act_window">
        <field name="name">Deduction Types</field>
        <field name="res_model">hr.deduction.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
