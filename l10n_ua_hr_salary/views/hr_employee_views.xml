<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_employee_form_psp_application" model="ir.ui.view">
        <field name="name">hr.employee.form.psp.application</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_psp_applications"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        type="object"
                        groups="hr.group_hr_user">
                    <field name="psp_application_count" widget="statinfo" string="Заяви ПСП"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
