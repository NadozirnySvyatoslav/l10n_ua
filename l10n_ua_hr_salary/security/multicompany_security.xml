<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             Models below carry a stored company_id but had no multi-company
             ir.rule, so records leaked across ALL companies. These global
             rules scope each model to the user's allowed companies. -->

        <record id="hr_execution_document_company_rule" model="ir.access">
            <field name="name">Виконавчий документ: multi-company</field>
            <field name="model_id" ref="model_hr_execution_document"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="hr_payslip_company_rule" model="ir.access">
            <field name="name">Розрахунковий листок: multi-company</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="hr_payslip_run_company_rule" model="ir.access">
            <field name="name">Відомість нарахування: multi-company</field>
            <field name="model_id" ref="model_hr_payslip_run"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="hr_salary_advance_company_rule" model="ir.access">
            <field name="name">Аванс: multi-company</field>
            <field name="model_id" ref="model_hr_salary_advance"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="hr_salary_advance_run_company_rule" model="ir.access">
            <field name="name">Відомість авансу: multi-company</field>
            <field name="model_id" ref="model_hr_salary_advance_run"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

        <record id="hr_psp_parameters_company_rule" model="ir.access">
            <field name="name">Параметри ПСП: multi-company</field>
            <field name="model_id" ref="model_hr_psp_parameters"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="operation">crud</field>
        </record>

    </data>
</odoo>
